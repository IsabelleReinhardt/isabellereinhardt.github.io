---
// Projekt-Detailseite — Grundbaustein für alle Projektseiten.
// Inhalte kommen aus src/data/projects.ts; Assets unter public/projects/<slug>/.
import Layout from '../../layouts/Layout.astro';
import MobileHeader from '../../components/MobileHeader.astro';
import LangToggle from '../../components/LangToggle.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { projects, COVER_ALT } from '../../data/projects';
import { NAV } from '../../data/site';

export function getStaticPaths() {
  // hidden: true → Projekt ist vorerst nicht online (keine Seite, nicht in NEXT PROJECT)
  return projects.filter((p) => !p.hidden).map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const coverAlt = COVER_ALT[project.slug] ?? project.title;
// optionaler Bildausschnitt für Cover + Video (z. B. Ayra: weiter oben, damit der Kopf drin ist)
const mediaStyle = project.hero.mediaPos ? `object-position:${project.hero.mediaPos}` : undefined;

// NEXT PROJECT als Fächer (Figma 174-4 zu / 174-110 offen): alle anderen Projekte als Karten.
// Plätze aus Figma: Mitte x in Rasterspalten, Mitte y in Rasterzeilen (ab Oberkante des Abschnitts),
// Drehung in Grad – von der hintersten (1.) bis zur vordersten (7.) Karte.
const visible = projects.filter((p) => !p.hidden);
const i = visible.findIndex((p) => p.slug === project.slug);
const others = Array.from({ length: visible.length - 1 }, (_, k) => visible[(i + 1 + k) % visible.length]);
const FAN_CLOSED = [[2.866, 0.938, 7.04], [2.716, 1.042, 2.51], [2.617, 1.183, -1.91], [2.560, 1.333, -5.64], [2.512, 1.500, -8.32], [2.496, 1.691, -11.73], [2.487, 1.890, -16.41]];
const FAN_OPEN   = [[4.124, -0.334, 27.35], [3.765, -0.132, 22.82], [3.314, 0.064, 18.41], [2.994, 0.428, 14.68], [2.748, 0.734, 11.99], [2.518, 1.216, 8.59], [2.378, 1.720, 0]];
// Bei weniger/mehr als 7 Projekten werden die Plätze gleichmäßig dazwischen verteilt.
const slotAt = (tbl: number[][], u: number) => {
  const a = Math.min(tbl.length - 2, Math.floor(u)), f = u - a;
  return tbl[a].map((v, k) => +(v + (tbl[a + 1][k] - v) * f).toFixed(3));
};
// Reihenfolge: hinten → vorne; das direkt nächste Projekt liegt ganz vorne
const fanCards = [...others].reverse().map((p, k, arr) => {
  const u = arr.length > 1 ? (k * (FAN_CLOSED.length - 1)) / (arr.length - 1) : FAN_CLOSED.length - 1;
  const [x0, y0, r0] = slotAt(FAN_CLOSED, u), [x1, y1, r1] = slotAt(FAN_OPEN, u);
  return { p, style: `--x0:${x0};--y0:${y0};--r0:${r0}deg;--x1:${x1};--y1:${y1};--r1:${r1}deg;z-index:${k + 1}` };
});

// IMPRESSION-Karussell: Bilder des Projekts. Damit das Band breit genug ist, wird die Bildfolge
// bei wenigen Bildern mehrfach wiederholt – und JEDE Wiederholung beginnt mit dem IMPRESSION-Feld,
// sonst taucht es bei vielen Bildern nur sehr selten auf.
const impImgs = project.impressions ?? [];
const impSets = impImgs.length ? Math.ceil(8 / impImgs.length) : 0;
const impLoop = Array.from({ length: impSets }, () => impImgs);   // [[bilder], [bilder], …]

// Galerie-Hero (z. B. Branding): Bilder/Videos als Leiste statt eines einzelnen Clips
const gallery = project.hero.gallery ?? [];
const hasGallery = gallery.length > 0;
const firstVideoIdx = gallery.findIndex((g) => g.type === 'video');
const galCenter = project.hero.galleryCenter ?? -1;   // ≥ 0: Galerie zentriert um dieses Element
---

<Layout>
  <div class="pd">
    <!-- EN/DE-Schalter für die Projekttexte (fest unten rechts, Footer schiebt sich darüber) -->
    <LangToggle theme="light" />
    <!-- Mobile-Header (fixiert, < md), helle Variante wie auf Contact -->
    <MobileHeader nav={NAV} theme="light" />

    <!-- Desktop-Header (wie Work-Seite, weiß-thematisiert) -->
    <SiteHeader p="pd" id="pdHeader" scrim />

    <!-- Inhalt: trägt das Raster. Desktop: klebt am Seitenende fest (sticky), während der Footer
         darüber hochfährt – wie auf Work/About. -->
    <main class="pd-main" id="pdMain">

    <!-- ===== Hero-Bühne (Desktop + Mobile, scroll-gekoppelt): Titel läuft hoch raus, Meta kommt
         von unten hoch, Video wandert nach unten & wächst. Maße je nach Raster (7 bzw. 4 Spalten). ===== -->
    <section class="pd-stage" id="pdStage">
      <div class="pd-pin">
        <div class="pd-title" id="pdTitle">{project.title}</div>

        <div class="pd-meta" id="pdMeta">
          <div class="cell cat">{project.category}</div>
          <div class="cell c3">{project.date}</div>
          <div class="cell c4">{project.type}</div>
          <div class="cell c5">{project.role}</div>
          <!-- Tools zeilenweise als Spans: Desktop untereinander, mobil in einer Zeile mit „·" -->
          <div class="cell c6">{project.tools.split('\n').map((s) => <span>{s}</span>)}</div>
          <div class="cell c7">{`credits\n${project.credits}`}</div>
        </div>

        <div class:list={['pd-video', hasGallery && 'is-gallery', galCenter >= 0 && 'is-gal-center']} id="pdVideo" data-gallery={hasGallery ? '1' : undefined}
             data-gal-center={galCenter >= 0 ? galCenter : undefined} data-gal-rows={project.hero.galleryRows} data-gal-fill={project.hero.galleryFill ? '1' : undefined}
             data-end-cols={project.hero.endCols} data-lb-extra={project.hero.lightboxExtra?.join('|')}>
          {hasGallery && (
            <Fragment>
              {/* Leiste: Elemente nebeneinander, Höhe = Box, Breite aus dem Seitenverhältnis.
                   Desktop: wird per Scrollen verschoben (JS), mobil: wischen (natives Scrollen). */}
              <div class="pd-gal" id="pdGal">
                <div class="pd-gal-track" id="pdGalTrack">
                  {gallery.map((g, k) => (
                    <figure class="pd-gal-item" style={`--ar:${g.ar}`} data-k={k}>
                      {g.type === 'video' ? (
                        <Fragment>
                          {g.poster && <img class="pd-gal-media" src={g.poster} alt="" aria-hidden="true" />}
                          {k === firstVideoIdx ? (
                            <video class="pd-gal-media pd-clip" id="pdMediaVideo" src={g.src} poster={g.poster} preload="none" muted loop playsinline></video>
                          ) : (
                            <video class="pd-gal-media pd-gal-auto" src={g.src} poster={g.poster} preload="none" muted loop playsinline></video>
                          )}
                        </Fragment>
                      ) : (
                        <img class="pd-gal-media" src={g.src} alt={g.alt ?? ''} loading={k < 3 ? 'eager' : 'lazy'} style={g.imgStyle} />
                      )}
                    </figure>
                  ))}
                </div>
              </div>
              {firstVideoIdx >= 0 && (
                <button class="pd-play" id="pdPlay" aria-label="Play video">
                  <svg viewBox="-9 -9 105 118" aria-hidden="true"><polygon points="0,0 87,50 0,100" /></svg>
                </button>
              )}
              <button class="pd-full pd-gal-full" id="pdGalFull" aria-label="View images in full screen">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" /></svg>
              </button>
            </Fragment>
          )}
          {!hasGallery && <Fragment>
          {/* Ebenen von unten nach oben: Querformat-Cover · Hochformat-Cover (nur mobil, blendet beim
               Scrollen aus, während die Box ins Querformat wächst) · Clip (blendet ein, sobald er läuft) */}
          <img class="pd-media pd-poster" src={project.hero.poster} alt={coverAlt} style={mediaStyle} />
          {project.hero.posterPortrait && (
            <img class="pd-media pd-poster-portrait" src={project.hero.posterPortrait} alt="" aria-hidden="true" />
          )}
          {project.hero.video && (
            <video class="pd-media pd-clip" id="pdMediaVideo" preload="none" muted loop playsinline style={mediaStyle}>
              <source src={project.hero.video} type="video/mp4" />
            </video>
          )}
          {/* Play: gibt es einen Link zum ganzen Film (z. B. YouTube), öffnet Play diesen in einem
               neuen Tab – der Clip ist dann nur die Vorschau. Sonst: eigenes Video mit Ton abspielen. */}
          {/* Form wie Figma: weißes Dreieck mit runden Ecken (abgerundet über die gleichfarbige Kontur) */}
          {project.hero.fullFilm ? (
            <a class="pd-play" href={project.hero.fullFilm} target="_blank" rel="noopener" aria-label="Watch the full film on YouTube (opens in a new tab)">
              <svg viewBox="-9 -9 105 118" aria-hidden="true"><polygon points="0,0 87,50 0,100" /></svg>
            </a>
          ) : (
            <button class="pd-play" id="pdPlay" aria-label="Play video">
              <svg viewBox="-9 -9 105 118" aria-hidden="true"><polygon points="0,0 87,50 0,100" /></svg>
            </button>
          )}
          {/* Ton an/aus für den Clip – erscheint, sobald der Clip läuft (Clip startet immer stumm) */}
          {project.hero.video && (
            <button class="pd-sound" id="pdSound" aria-label="Turn sound on" aria-pressed="false">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path class="spk" d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
                <path class="off" d="M15.5 9.5l5 5M20.5 9.5l-5 5" />
                <path class="on" d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.5a7.8 7.8 0 0 1 0 11" />
              </svg>
            </button>
          )}
          {project.hero.names && project.hero.names.length > 0 && (
            <div class="pd-names">{project.hero.names.map((n) => <span>{n}</span>)}</div>
          )}
          {project.hero.filmBy && (
            <div class="pd-cap"><b>A FILM BY</b><i>{project.hero.filmBy}</i></div>
          )}
          {project.hero.video && !project.hero.fullFilm && (
            <button class="pd-full" id="pdFull" aria-label="Watch video in full screen">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" /></svg>
            </button>
          )}
          {/* Link zum ganzen Film (extern, z. B. YouTube) – reiner Link, lädt nichts von YouTube vorab */}
          {project.hero.fullFilm && (
            <a class="pd-ext" href={project.hero.fullFilm} target="_blank" rel="noopener">full film ↗</a>
          )}
          </Fragment>}
        </div>
      </div>
    </section>

    <!-- ===== IMPRESSION: eine Zeile Abstand zum Video, dann Endlos-Karussell (1 Zeile hoch,
         beim Hover 2 Zeilen). Die Bildfolge steht zweimal im Track → nahtlose Schleife. ===== -->
    {impLoop.length > 0 && (
      <section class="pd-imp" id="pdImp" aria-label="Impressions">
        <div class="pd-imp-band">
          <div class="pd-imp-track" id="pdImpTrack">
            {[0, 1].map((copy) => impLoop.map((set, k) => [
              // IMPRESSION läuft als eigenes Feld mit (1 Spalte breit) – vor jedem Durchgang der Bilder
              <div class="pd-imp-lbl" aria-hidden={copy === 1 || k > 0 ? 'true' : undefined}><span>Impression</span></div>,
              ...set.map((src) => <img src={src} alt="" aria-hidden={copy === 1 ? 'true' : undefined} />),
            ]))}
          </div>
        </div>
      </section>
    )}

    <!-- ===== Textbereich: festes Raster (7 Spalten × 8 Zeilen). Zeile 1 bleibt frei
         (Platz für die aufgeklappte Impression-Leiste), Zeilen 7–8 sind Luft vor NEXT PROJECT. ===== -->
    <section class="pd-text" id="pdText">
      {project.body[0] && <div class="t t1"><p><span data-l="en" set:html={project.body[0]} /><span data-l="de" set:html={project.bodyDe?.[0] ?? project.body[0]} /></p></div>}
      {project.body[1] && <div class="t t2"><p><span data-l="en" set:html={project.body[1]} /><span data-l="de" set:html={project.bodyDe?.[1] ?? project.body[1]} /></p></div>}
      {project.body[2] && <div class="t t3"><p><span data-l="en" set:html={project.body[2]} /><span data-l="de" set:html={project.bodyDe?.[2] ?? project.body[2]} /></p></div>}
      <!-- Kreis, der beim Hover über einen Text zu dessen Stichwort morpht (nur Desktop) -->
      <div class="pd-morph" aria-hidden="true">
        <div class="circle"></div>
        <span class="word w1">Idea</span>
        <span class="word w2">Process</span>
        <span class="word w3">Upshot</span>
      </div>
    </section>

    <!-- ===== NEXT PROJECT: Fächer aus Titelbildern. Hover (mobil: Antippen) öffnet den Fächer,
         die Karte unter der Maus hebt sich wie aus einer Mappe heraus; Klick öffnet das Projekt. ===== -->
    {fanCards.length > 0 && (
      <nav class="pd-fan" id="pdFan" aria-label="More projects">
        <div class="fan-zone" aria-hidden="true"></div>
        {fanCards.map(({ p, style }) => (
          <a class="fan-card" href={`/work/${p.slug}`} style={style} aria-label={`${p.title}, ${p.category.replace('\n', ' ')}`}>
            <span class="fan-inner"><img src={p.cover} alt="" loading="lazy" style={p.coverPos ? `object-position:${p.coverPos}` : undefined} /></span>
          </a>
        ))}
        <span class="np" aria-hidden="true">Next<br />Project</span>
      </nav>
    )}
    </main>

    {/* Vollbild-Ansicht der Galerie: ein Element groß, Pfeile links/rechts, Esc/× schließt */}
    {hasGallery && (
      <div class="pd-lb" id="pdLb" role="dialog" aria-modal="true" aria-label="Gallery in full screen" hidden>
        <div class="pd-lb-stage" id="pdLbStage"></div>
        <button class="pd-lb-btn pd-lb-prev" id="pdLbPrev" aria-label="Previous image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8" /></svg>
        </button>
        <button class="pd-lb-btn pd-lb-next" id="pdLbNext" aria-label="Next image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
        </button>
        <button class="pd-lb-btn pd-lb-close" id="pdLbClose" aria-label="Close full screen">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
        </button>
        <span class="pd-lb-count" id="pdLbCount"></span>
      </div>
    )}

    <!-- Footer-Scrollzone: echte Seitenlänge am Ende, in die man hineinscrollt (treibt den Footer) -->
    <div class="pd-footer-space" id="pdFooterSpace" aria-hidden="true"></div>

    <!-- Footer wie Work/About, aber weiß: schiebt sich am Seitenende von unten hoch -->
    <SiteFooter p="pd" id="pdFooter" />
  </div>
</Layout>

<style is:global>
  .pd {
    --pd-line: #D7D7D7;            /* helle Rasterlinien auf weißem Grund */
    --pd-row: 170px;              /* Rasterzeilenhöhe (wie übrige Seiten) */
    /* Fließtext unten: wächst/schrumpft mit der Fensterbreite (1.05rem bei 1512px, kleinstens 0.8rem) */
    --pd-text: clamp(0.8rem, 1.111vw, 1.05rem);
    --pd-small: calc(1.05rem - 1px); /* Metazeile + IMPRESSION-Label */
    position: relative; width: 100%;
    background-color: var(--color-off); color: var(--color-ink);
  }
  /* Inhalt mit Raster (7 Spalten + waagerechte Zeilen). Das Raster sitzt hier statt auf .pd,
     damit es beim Footer-Reveal mit dem festgehaltenen Inhalt stehen bleibt. */
  .pd-main {
    display: block; position: relative; background-color: var(--color-off);
    padding-bottom: var(--pd-row);   /* 1 freie Rasterzeile unter der Next-Leiste */
    background-image:
      linear-gradient(to right, var(--pd-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--pd-line) 1px, transparent 1px);
    background-size: calc(100% / 7) 100%, 100% var(--pd-row);
    background-position: -1px 0, 0 -1px;
  }

  /* ---------- Desktop-Header (fix) ---------- */
  .pd-header {
    position: fixed; inset-inline: 0; top: 0; z-index: 50; height: var(--pd-row);
    display: none; grid-template-columns: repeat(7, 1fr); align-items: center;
  }
  /* Scrim wie Work-Seite, nur weiß: blendet beim Scrollen ein, damit die schwarze Nav über
     dem dunklen Video lesbar bleibt (keine harte Kante). Reicht max. bis zur Hälfte der 2. Rasterzeile. */
  .pd-scrim {
    position: absolute; left: 0; top: 0; width: 100%; z-index: 0; height: calc(var(--pd-row) * 1.5);
    background: linear-gradient(to bottom,
      rgba(249, 249, 249,0.97) 0%, rgba(249, 249, 249,0.93) 18%, rgba(249, 249, 249,0.82) 34%,
      rgba(249, 249, 249,0.63) 50%, rgba(249, 249, 249,0.4) 65%, rgba(249, 249, 249,0.19) 80%,
      rgba(249, 249, 249,0.06) 91%, rgba(249, 249, 249,0) 100%);
    opacity: 0; transition: opacity .3s ease; pointer-events: none;
  }
  .pd-header.is-scrolled .pd-scrim { opacity: 1; }
  .pd-home { grid-column: 1; display: flex; align-items: center; justify-content: center; position: relative; z-index: 1; }
  .pd-home { --logo-c: var(--color-ink); }   /* Monogramm schwarz auf hellem Grund (Hover: neongrün) */
  .pd-nav {
    display: flex; align-items: center; justify-content: center; position: relative; z-index: 1;
    font-family: var(--font-display); font-weight: 500; font-size: 0.875rem;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-ink);
    text-decoration: none; transition: color .2s, opacity .2s;
  }
  .pd-nav:hover { color: var(--color-neon); }
  /* Ganze Rasterkachel ist klickbar und löst den Hover aus (Link füllt die volle Zeilenhöhe) */
  .pd-home, .pd-nav { align-self: stretch; }
  .pd-work { grid-column: 5; } .pd-about { grid-column: 6; } .pd-contact { grid-column: 7; }

  /* ---------- Hero-Bühne (Desktop): .pd-pin bleibt 1 Screen lang stehen (Scrubbing) ---------- */
  .pd-stage { position: relative; height: calc(100vh + 800px); }
  .pd-pin { position: sticky; top: 0; height: 100vh; }
  /* Titel wie Figma: ExtraBold, 120px bei 1512px Breite (= 7.94vw), Mitte auf 318px →
     das Video (z-index 2, ab 340px) schneidet den unteren Teil der Buchstaben an. */
  .pd-title {
    position: absolute; left: 50%; top: 318px; transform: translate(-50%, -50%); z-index: 1;
    white-space: nowrap; font-family: var(--font-display); font-weight: 800; font-size: 7.94vw;
    line-height: normal; text-transform: uppercase; color: var(--color-neon);
    filter: blur(5px); will-change: transform, opacity;
  }
  /* Metazeile: eine Rasterzeile hoch, landet am Ende mittig im Bildschirm (Position per JS),
     in Kleinbuchstaben (wie Figma) */
  .pd-meta {
    /* z-index 1: liegt UNTER dem wachsenden Titelbild (z 2) → die Infos blitzen nicht durchs Bild */
    position: absolute; left: 0; right: 0; top: 0; height: var(--pd-row); z-index: 1;
    display: grid; grid-template-columns: repeat(7, 1fr); align-items: center;
    will-change: transform, opacity;
    pointer-events: none;   /* reine Textzeile, liegt über dem Video → Klicks gehen durch (Lautsprecher, Play) */
  }
  .pd-meta .cell {
    /* wie Figma: mittig im Rasterquadrat, Umbrüche kommen aus den Daten (\n → pre-line),
       1px kleiner als die Texte unten */
    padding: 0 0.6rem; font-family: var(--font-display); font-weight: 300; font-size: var(--pd-small);
    line-height: 1.3; text-align: center; white-space: pre-line;
  }
  .pd-meta .cat { grid-column: 1; font-weight: 500; text-transform: uppercase; letter-spacing: 0.2em; }
  .pd-meta .c3 { grid-column: 3; } .pd-meta .c4 { grid-column: 4; } .pd-meta .c5 { grid-column: 5; }
  .pd-meta .c6 { grid-column: 6; } .pd-meta .c7 { grid-column: 7; }
  .pd-meta .c6 span { display: block; }
  .pd-video {
    position: absolute; z-index: 2; overflow: hidden; background: #2a2622;
    will-change: left, top, width, height;
    contain: layout paint;   /* Größenänderung beim Wachsen bleibt auf die Box beschränkt (schneller, v. a. iPhone) */
  }
  .pd-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pd-poster-portrait { display: none; }   /* Hochformat-Cover nur mobil */
  /* Clip: unsichtbar, bis er wirklich läuft (dann weich über das Cover blenden) */
  .pd-clip { opacity: 0; transition: opacity .6s ease; }
  .pd-clip.is-playing { opacity: 1; }
  /* Play wie Figma: weißes, abgerundetes Dreieck ohne Kreis, 50 % Deckkraft.
     Größe wächst mit dem Bild: ~9 % der Bildbreite (Figma: 140px bei 1512px), cqw = % der Video-Box. */
  .pd-video { container-type: inline-size; }
  .pd-play {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: clamp(34px, 9.3cqw, 150px); aspect-ratio: 105 / 118; padding: 0;
    border: 0; background: none; cursor: pointer; z-index: 2; opacity: .5;
    transition: opacity .25s ease, transform .25s ease;
  }
  .pd-play svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .pd-play polygon { fill: #fff; stroke: #fff; stroke-width: 18; stroke-linejoin: round; }
  .pd-play:hover, .pd-play:focus-visible { opacity: .85; transform: translate(-50%, -50%) scale(1.06); }
  .pd-play.is-hidden { opacity: 0; pointer-events: none; transition: opacity .25s; }

  /* Lautsprecher (Ton an/aus) unten links – erst sichtbar, wenn der Clip läuft.
     Gleiche Optik wie „full film ↗": neon, gleiche Schriftgröße (em) und Linienstärke wie der Pfeil,
     gespiegelt zum Link (gleicher Randabstand), Hover weiß. */
  .pd-sound {
    position: absolute; left: 22px; bottom: 18px; z-index: 3;
    font-size: 0.95rem; width: 1.35em; height: 1.35em; padding: 0;
    border: 0; background: none; cursor: pointer; opacity: 0; pointer-events: none;
    color: var(--color-neon); transition: opacity .3s ease, color .2s ease;
  }
  .pd-clip.is-playing ~ .pd-sound { opacity: 1; pointer-events: auto; }
  .pd-sound:hover { color: #fff; }
  .pd-sound svg { display: block; width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 8px rgba(0,0,0,.45)); }
  .pd-sound .on { display: none; }
  .pd-sound[aria-pressed='true'] .on { display: inline; }
  .pd-sound[aria-pressed='true'] .off { display: none; }
  .pd-names {
    position: absolute; top: 14px; left: 0; right: 0; z-index: 2; display: flex; justify-content: space-around;
    color: #fff; font-family: var(--font-display); font-size: 0.72rem; opacity: 0.85;
  }
  .pd-cap { position: absolute; left: 0; right: 0; bottom: 20px; z-index: 2; text-align: center; color: #fff; font-family: var(--font-display); }
  .pd-cap b { display: block; font-weight: 600; font-size: 0.8rem; letter-spacing: 0.12em; }
  .pd-cap i { font-style: normal; font-weight: 300; font-size: 0.75rem; opacity: 0.85; }
  /* Vollbild-Knopf unten rechts im Video (wie Figma: zwei Pfeile nach außen) */
  .pd-full {
    position: absolute; right: 14px; bottom: 14px; z-index: 3; width: 34px; height: 34px; padding: 5px;
    border: 0; background: none; cursor: pointer; opacity: 0.9; transition: transform .2s ease, opacity .2s ease;
  }
  .pd-full:hover { transform: scale(1.12); opacity: 1; }
  /* auf hellen Bildstellen (per Helligkeits-Messung) schwarz statt weiß */
  .pd-full svg, .pd-play polygon { transition: stroke .25s ease, fill .25s ease; }
  .pd-full.is-dark svg { stroke: #000; }
  .pd-play.is-dark polygon { fill: #000; stroke: #000; }
  .pd-full svg { display: block; width: 100%; height: 100%; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  /* „full film ↗" unten rechts im Video: neon + kräftiger, damit es heraussticht.
     Leichter dunkler Schatten → bleibt auch auf hellen Bildstellen lesbar. Hover: weiß. */
  .pd-ext {
    position: absolute; right: 22px; bottom: 20px; z-index: 3;
    font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; letter-spacing: 0.2em;
    text-transform: lowercase; color: var(--color-neon); text-decoration: none;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.45); transition: color .2s ease;
  }
  .pd-ext:hover { color: #fff; }

  /* ---------- IMPRESSION-Karussell ----------
     .pd-imp nimmt im Fluss genau 1 Zeile ein (davor 1 Zeile Abstand zum Video). Das Band liegt
     absolut darin und wächst beim Hover auf 2 Zeilen – über die freie Zeile darunter, damit
     nichts verrutscht. Bilder sind 100 % hoch, Breite automatisch → wachsen proportional mit. */
  .pd-imp { position: relative; z-index: 4; height: var(--pd-row); margin-top: calc(var(--pd-row) * 2); }   /* 2 Zeilen Abstand zum großen Projekt */
  /* clip-path schneidet nur das BILD ab – die lange Bildleiste würde die Seite trotzdem breiter machen
     (mobil: Seite zoomt raus, Header gestreckt). overflow-x: clip verhindert das, oben/unten bleibt frei. */
  .pd-imp { overflow-x: clip; }
  /* Seitlich abgeschnitten, oben/unten darf ein gehovertes Bild eine halbe Zeile überstehen */
  .pd-imp-band {
    position: absolute; left: 0; right: 0; top: 0; height: var(--pd-row);
    clip-path: inset(calc(var(--pd-row) * -0.5) 0);
  }
  .pd-imp-track { display: flex; gap: 1px; height: 100%; width: max-content; will-change: transform; }
  .pd-imp-track img {
    display: block; height: 100%; width: auto; flex: none; position: relative;
    transition: transform .45s cubic-bezier(.22, 1, .36, 1);
  }
  /* Hover: nur dieses Bild wird größer – doppelte Höhe = oben und unten je eine halbe Zeile über */
  @media (hover: hover) and (min-width: 768px) {
    .pd-imp-track img:hover { transform: scale(2); z-index: 2; }
  }
  /* IMPRESSION-Feld im Karussell: immer genau 1 Spalte breit (--imp-col, per JS gesetzt), weiß.
     Beim Hover wird es mit dem Band 2 Zeilen hoch → weiße Lücke über die ganze Leiste;
     das Wort bleibt mittig in der oberen Zeile. */
  .pd-imp-lbl {
    flex: none; width: var(--imp-col, calc(100vw / 7)); height: 100%; background: var(--color-off);
  }
  .pd-imp-lbl span {
    display: flex; align-items: center; justify-content: center; height: var(--pd-row);
    font-family: var(--font-display); font-weight: 500; font-size: var(--pd-small);
    letter-spacing: 0.2em; text-transform: uppercase;
  }

  /* ---------- Textbereich: Raster 7 Spalten × 8 Zeilen ----------
     Zeilen zählen ab der freien Zeile unter der Impression-Leiste (= Zeile 1). */
  .pd-text {
    display: grid; grid-template-columns: repeat(7, 1fr); grid-template-rows: repeat(8, var(--pd-row));
  }
  /* Textblock mittig (horizontal + vertikal) in seinen 4 Rasterquadraten, 50px zur Rasterlinie links & rechts */
  .pd-text .t { display: flex; align-items: center; justify-content: center; padding: 0 clamp(24px, 3.3vw, 50px); }
  .pd-text .t p {
    font-family: var(--font-display); font-weight: 300; font-size: var(--pd-text); line-height: 1.6;
    letter-spacing: 0.01em; margin: 0; transition: font-weight .35s ease;   /* Variable Font → weicher Übergang */
  }
  /* Links im Fließtext (z. B. www.baubuerozam.de): gleiche Schrift, dezent unterstrichen */
  .pd-text .t p a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .pd-text .t p a:hover { opacity: .6; }
  .pd-text .t1 { grid-column: 2 / 4; grid-row: 2 / 4; }
  .pd-text .t2 { grid-column: 5 / 7; grid-row: 3 / 5; text-align: right; }   /* rechtsbündig wie Figma */
  .pd-text .t3 { grid-column: 5 / 7; grid-row: 5 / 7; text-align: right; }

  /* ---------- Kreis ↔ Stichwort (Morph) ----------
     Kreis und die drei Wörter liegen übereinander in derselben Rasterfläche (Spalte 2–3, Zeile 4–6).
     Hover über einen Text: der Kreis staucht sich zu einem flachen Oval in Wortgröße zusammen und
     verschwimmt, gleichzeitig wächst das Wort unscharf aus der Mitte heraus → wirkt wie ein Morph.
     Reines CSS (:has), keine Library. */
  .pd-morph {
    grid-column: 2 / 4; grid-row: 4 / 7; display: grid; place-items: center; pointer-events: none;
  }
  .pd-morph > * { grid-area: 1 / 1; }
  .pd-morph .circle {
    /* Durchmesser = maximale Textbreite: gleiche 2 Spalten wie die Textblöcke, minus dieselben
       50px Abstand zur Rasterlinie links + rechts (siehe .pd-text .t). Höhe als Sicherheitsgrenze. */
    width: min(calc(100% - 2 * clamp(24px, 3.3vw, 50px)), calc(var(--pd-row) * 3)); aspect-ratio: 1;
    border: 2px solid var(--color-neon); border-radius: 50%; filter: blur(2.5px);   /* etwas schärfer (vorher 4px) */
    /* Rückweg (Wort → Kreis): Kreis entfaltet sich mit kurzer Verzögerung wieder */
    transition: transform .6s cubic-bezier(.22, 1, .36, 1) .12s, opacity .4s ease .12s, filter .6s ease .12s;
  }
  .pd-morph .word {
    color: var(--color-neon); font-family: var(--font-display); font-weight: 800; font-size: 3.97vw;   /* 60px bei 1512 wie Figma */
    line-height: 1; text-transform: uppercase; white-space: nowrap;
    opacity: 0; transform: scale(.55); filter: blur(14px);
    transition: opacity .3s ease, transform .45s ease, filter .45s ease;
  }
  @media (hover: hover) and (min-width: 768px) {
    .pd-text .t p:hover { font-weight: 500; }   /* Light → Medium */
    .pd-text:has(.t p:hover) .circle {
      transform: scale(.45, .14); opacity: 0; filter: blur(12px);
      transition: transform .5s cubic-bezier(.22, 1, .36, 1), opacity .35s ease .12s, filter .5s ease;
    }
    .pd-text:has(.t1 p:hover) .w1,
    .pd-text:has(.t2 p:hover) .w2,
    .pd-text:has(.t3 p:hover) .w3 {
      opacity: 1; transform: none; filter: blur(3px);   /* weniger unscharf (vorher 5px wie Figma) */
      transition: opacity .45s ease .15s, transform .6s cubic-bezier(.22, 1, .36, 1) .1s, filter .6s ease .1s;
    }
  }

  /* ---------- NEXT PROJECT-Fächer (Figma 174-4 / 174-110) ----------
     3 Zeilen hoch; der offene Fächer ragt nach oben in die freien Zeilen über dem Abschnitt.
     Jede Karte bekommt ihre Plätze als Variablen (--x/--y in Spalten/Zeilen, --r Drehung);
     .is-open schaltet von „zu" auf „offen", die Bewegung macht die CSS-Transition. */
  .pd-fan {
    --col: calc(100vw / 7); --row: var(--pd-row);
    --cw: calc(var(--col) * 1.958); --ch: calc(var(--col) * 1.028);   /* Karte 423 × 222 (Figma) */
    position: relative; height: calc(var(--pd-row) * 3); z-index: 5;
  }
  .fan-card {
    position: absolute; left: 0; top: 0; width: var(--cw); height: var(--ch); display: block;
    transform: translate(calc(var(--x0) * var(--col) - 50%), calc(var(--y0) * var(--row) - 50%)) rotate(var(--r0));
    transition: transform .7s cubic-bezier(.22, 1, .36, 1);
  }
  .pd-fan.is-open .fan-card {
    transform: translate(calc(var(--x1) * var(--col) - 50%), calc(var(--y1) * var(--row) - 50%)) rotate(var(--r1));
  }
  /* Innenteil: hebt sich beim Hover entlang der eigenen Kartenachse ein Stück heraus */
  .fan-inner {
    position: absolute; inset: 0; overflow: hidden; background: #111;
    box-shadow: 0 6px 18px rgba(0,0,0,0.18);
    transition: transform .45s cubic-bezier(.22, 1, .36, 1), box-shadow .45s ease;
  }
  .fan-inner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pd-fan.is-open .fan-card:hover .fan-inner,
  .pd-fan.is-open .fan-card:focus-visible .fan-inner {
    transform: translateY(-16%) scale(1.03); box-shadow: 0 18px 36px rgba(0,0,0,0.28);
  }
  /* unsichtbare Fläche um den offenen Fächer → er bleibt offen, auch wenn die Maus durch Lücken fährt */
  .fan-zone {
    position: absolute; left: calc(var(--col) * 1.1); width: calc(var(--col) * 4.3);
    top: calc(var(--row) * -1.6); height: calc(var(--row) * 4.4); pointer-events: none;
  }
  .pd-fan.is-open .fan-zone { pointer-events: auto; }
  .pd-fan .np {
    position: absolute; left: calc(var(--col) * 4); width: calc(var(--col) * 2); top: calc(var(--row) * 1.465);
    transform: translateY(-50%); pointer-events: none;
    color: var(--color-neon); font-family: var(--font-display); font-weight: 800; font-size: 3.97vw;   /* 60px bei 1512 */
    line-height: 1.05; text-transform: uppercase; text-align: center; filter: blur(3.5px);
  }

  /* ---------- Footer (wie Work/About, weiß) ----------
     Fixierte Ebene, die per Scroll in die Fußzone von unten hochfährt (transform per JS, 1:1).
     Weißer Verlauf mit Frosted-Glass über dem festgehaltenen Inhalt, obere Kante läuft aus. */
  .pd-footer {
    position: fixed; inset: 0; z-index: 40;   /* unter dem Header (50) → Nav bleibt sichtbar */
    transform: translateY(100%); will-change: transform; pointer-events: none;
    background: linear-gradient(to top,
      rgba(249, 249, 249,0.94) 0%, rgba(249, 249, 249,0.9) 30%, rgba(249, 249, 249,0.72) 55%,
      rgba(249, 249, 249,0.4) 78%, rgba(249, 249, 249,0) 100%);
    -webkit-backdrop-filter: blur(7px);
            backdrop-filter: blur(7px);
    -webkit-mask-image: linear-gradient(to top, #000 0%, #000 78%, transparent 100%);
            mask-image: linear-gradient(to top, #000 0%, #000 78%, transparent 100%);
  }
  .pd-footer.is-active { pointer-events: auto; }
  .pd-footer-inner { display: contents; }
  .pd-footer-space { height: 100vh; }
  @media (max-width: 767px) { .pd-footer-space { height: 100vh; } }   /* mobil: Footer steigt so schnell auf wie am Desktop */   /* Scrollzone, in die man hineinscrollt */
  .pd-footer-logo {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    padding-top: var(--pd-row);
  }
  .pd-footer-logo img { width: 15vw; max-width: 210px; height: auto; }
  .pd-footer-bar {
    position: absolute; left: 0; right: 0; bottom: 0; height: var(--pd-row);
    display: grid; grid-template-columns: repeat(7, 1fr); align-items: center;
    font-family: var(--font-display); font-weight: 500; font-size: 0.875rem;
    text-transform: uppercase; letter-spacing: 0.2em; color: var(--color-ink);
  }
  .pd-footer-bar a { color: var(--color-ink); text-decoration: none; transition: color .2s; }
  .pd-footer-bar a:hover { color: var(--color-neon); }
  .pd-footer-li { grid-column: 1; grid-row: 1; justify-self: center; }
  .pd-footer-mail { grid-column: 4; grid-row: 1; justify-self: center; text-transform: none; letter-spacing: 0.1em; font-weight: 300; }
  .pd-footer-legal { display: contents; }
  .pd-footer-legal a:nth-of-type(1) { grid-column: 6; grid-row: 1; justify-self: center; }
  .pd-footer-legal a:nth-of-type(2) { grid-column: 7; grid-row: 1; justify-self: center; }

  /* ========== Desktop ab 768px: Header + Scrubbing aktiv ========== */
  .pd-main { position: sticky; }   /* top wird per JS gesetzt (Inhaltsunterkante rastet unten ein) – Desktop UND mobil */
  @media (min-width: 768px) {
    .pd-header { display: grid; }
  }

  /* ========== Mobile (bis 767px): gleiche Scroll-Bühne, Raster 4 Spalten × 25vw ========== */
  /* ---------- Galerie-Hero (z. B. Branding) ----------
     Statt eines Clips liegt eine Leiste in der wachsenden Box. Elemente = volle Box-Höhe,
     Breite aus dem Seitenverhältnis (--ar). Das 1. Element füllt am Anfang genau die Startbox
     (Breite per JS), danach wird die Leiste sichtbar und per Scrollen verschoben. */
  .pd-video.is-gallery { background: var(--color-off); }
  .pd-gal { position: absolute; inset: 0; overflow: hidden; }
  .pd-gal-track { display: flex; gap: 1px; height: 100%; width: max-content; will-change: transform; }
  .pd-gal-item { position: relative; margin: 0; height: 100%; aspect-ratio: var(--ar); flex: none; overflow: hidden; background: #2a2622; }
  .pd-gal-item:first-child, .pd-gal-item.is-grow { aspect-ratio: auto; }   /* Breite setzt das JS (wächst von Startbox → Seitenverhältnis) */
  .is-gal-center .pd-gal-item:first-child:not(.is-grow) { aspect-ratio: var(--ar); }
  .pd-gal-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .pd-gal-full { right: 18px; bottom: 16px; }
  html.gal-pinned .lang-toggle { opacity: 0; pointer-events: none; }
  .lang-toggle { transition: opacity .3s ease; }

  /* Vollbild-Ansicht */
  .pd-lb {
    position: fixed; inset: 0; z-index: 100; background: #0b0b0b;
    display: flex; align-items: center; justify-content: center;
  }
  .pd-lb[hidden] { display: none; }
  .pd-lb-stage { position: absolute; inset: 70px 90px; display: flex; align-items: center; justify-content: center; }
  .pd-lb-stage img, .pd-lb-stage video { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
  .pd-lb-btn {
    position: absolute; z-index: 2; width: 46px; height: 46px; padding: 10px; border: 0; background: none;
    cursor: pointer; color: #fff; opacity: .75; transition: opacity .2s, transform .2s, color .2s;
  }
  .pd-lb-btn:hover, .pd-lb-btn:focus-visible { opacity: 1; color: var(--color-neon); }
  .pd-lb-btn svg { display: block; width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .pd-lb-prev { left: 24px; top: 50%; transform: translateY(-50%); }
  .pd-lb-next { right: 24px; top: 50%; transform: translateY(-50%); }
  .pd-lb-close { right: 22px; top: 18px; }
  .pd-lb-count {
    position: absolute; left: 50%; bottom: 24px; transform: translateX(-50%); color: #fff; opacity: .7;
    font-family: var(--font-display); font-weight: 500; font-size: 0.8rem; letter-spacing: 0.2em;
  }
  @media (max-width: 767px) {
    /* mobil: Leiste wird gewischt (natives horizontales Scrollen, rastet je Element ein) */
    /* proximity statt mandatory: iOS hält sonst beim Zurückwischen am aktuellen Bild fest;
       overscroll-behavior: Wischen am Leistenrand löst keine Browser-Geste aus;
       touch-action: waagerecht = Leiste, senkrecht = Seite */
    .pd-gal { overflow-x: auto; overflow-y: hidden; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; scrollbar-width: none;
              overscroll-behavior-x: contain; touch-action: pan-x pan-y; }
    .pd-gal::-webkit-scrollbar { display: none; }
    .pd-gal-item { scroll-snap-align: start; }
    .is-gal-center .pd-gal { overflow: hidden; touch-action: pan-y; }   /* Porträts: Wischen per JS (Leiste bleibt um das Mittelbild zentriert) */   /* Porträts: kein Wischen, mittig zentriert */
    .pd-gal-full { right: 2.6vw; bottom: 2.6vw; width: 8vw; height: 8vw; padding: 1.4vw; }
    .pd-lb-stage { inset: 16vw 2vw; }
    .pd-lb-prev, .pd-lb-next { top: auto; bottom: 4vw; transform: none; }
    .pd-lb-prev { left: 4vw; } .pd-lb-next { right: 4vw; }
    .pd-lb-count { bottom: 7vw; }
  }

  @media (max-width: 767px) {
    .pd { --pd-row: 25vw; }
    .pd-main { background-size: calc(100% / 4) 100%, 100% 25vw; padding-bottom: 25vw; }  /* 4-Spalten-Raster + Zeilen wie andere Mobile-Seiten */
    /* Footer mobil wie Work: Logo + Links als ein unten verankerter Block, untereinander */
    .pd-footer-inner { display: block; position: absolute; left: 0; right: 0; bottom: 9vw; text-align: center; }
    .pd-footer-logo { position: static; inset: auto; padding: 0; display: block; margin: 0; }
    .pd-footer-logo img { display: block; width: 28.8vw; max-width: 208px; margin: 0 auto 20px; }
    .pd-footer-bar {
      position: static; inset: auto; height: auto; padding: 0; display: block; grid-template-columns: none;
      text-align: center; font-size: 0.875rem; letter-spacing: 0.12em;   /* = Mobile-Navigation */
    }
    .pd-footer-mail, .pd-footer-li, .pd-footer-legal { grid-column: auto; justify-self: auto; }
    .pd-footer-mail { display: block; }
    .pd-footer-li { display: block; margin-top: 4.2vw; }
    .pd-footer-legal { display: block; margin-top: 4.2vw; }
    .pd-footer-legal a { display: block; }
    .pd-footer-legal a + a { margin-top: 4.2vw; }
    /* Hero: Video startet hochkant in Spalte 2–3 / Zeile 3–5. Positionen/Größen beim Scrollen
       kommen aus dem JS. */
    /* Titel so groß wie die Kategorie-Überschriften auf Work mobil (15vw, Blur 1.2vw). Darf
       umbrechen; an der Unterkante verankert (6vw unter der Video-Oberkante) → die letzte Zeile
       wird immer etwa zur Hälfte vom Video angeschnitten, egal wie viele Zeilen der Titel hat. */
    .pd-title {
      --title-y: -100%;
      top: calc(25vw * 2 + 6vw); transform: translate(-50%, -100%);
      width: 100%; font-size: 15vw; line-height: 1; filter: blur(1.2vw);
      white-space: normal; text-align: center;
    }
    /* Infos: wie Desktop je mittig in einem eigenen Rasterquadrat, verteilt auf 2 Zeilen,
       rechtsbündig in Spalte 2–4 (Reihenfolge: Kategorie · Datum · Art / Rolle · Tools · Credits) */
    .pd-imp { margin-top: var(--pd-row); touch-action: pan-y; }   /* mobil: 1 Zeile Abstand; waagerecht wischen → Leiste */
    .pd-meta {
      left: 25vw; right: 0; height: 50vw;
      grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 25vw);
    }
    .pd-meta .cell { padding: 0 1vw; font-size: 2.6vw; line-height: 1.35; }
    .pd-meta .cell, .pd-meta .cat, .pd-meta .c3, .pd-meta .c4,
    .pd-meta .c5, .pd-meta .c6, .pd-meta .c7 { grid-column: auto; }   /* Desktop-Spalten zurücksetzen → automatisch der Reihe nach */
    .pd-meta .cat { letter-spacing: 0.08em; }
    .pd-sound { left: 3vw; bottom: 2.6vw; font-size: 0.875rem; }   /* = „full film“ mobil */
    .pd-names { top: 2vw; font-size: 2vw; }
    .pd-cap { bottom: 2.5vw; }
    .pd-cap b { font-size: 2.2vw; } .pd-cap i { font-size: 2vw; }
    .pd-full { right: 1.5vw; bottom: 1.5vw; width: 8vw; height: 8vw; padding: 1.5vw; }
    /* = Schrift im Mobile-Header. Im Hochformat-Start würde es überall Cover-Text überdecken →
       blendet erst mit dem großen Querformat ein (dort ist unten rechts frei); vorher führt Play zum Film */
    .pd-ext { right: 3vw; bottom: 3vw; font-size: 0.875rem; letter-spacing: 0.12em; opacity: var(--t); }
    /* Hochformat-Cover beim Start (hochkante Box), blendet mit dem Scroll-Fortschritt (--t) aus,
       während die Box ins Querformat wächst → darunter erscheint das Querformat-Cover */
    .pd-poster-portrait { display: block; opacity: calc(1 - var(--t, 0)); }
    /* Impression: läuft auch mobil (ohne Hover), 1 Rasterzeile hoch, IMPRESSION-Feld = 1 Spalte */
    .pd-imp-band, .pd-imp:hover .pd-imp-band { height: 25vw; }
    .pd-imp-lbl span { font-size: 2.6vw; letter-spacing: 0.12em; }
    /* Texte: untereinander über alle 4 Spalten. Jeder Text belegt ganze Rasterzeilen (Höhe per JS
       auf volle Zeilen aufgerundet, Text mittig darin), dazwischen je 1 freie Zeile.
       Oben 1 freie Zeile (nach der Impression-Leiste), unten 2 freie Zeilen vor Next Project. */
    .pd-text { display: block; padding: 25vw 0; }
    .pd-text .t { display: flex; align-items: center; padding: 0 5vw; margin-bottom: 25vw; text-align: left; }
    /* Fließtext: auf dem Handy gut lesbar (~15px auf dem iPhone, nie unter 14px) */
    .pd-text .t p { font-size: var(--text-mobile); line-height: 1.55; }
    .pd-morph { display: none; }   /* Kreis/Morph braucht Hover → mobil weggelassen */
    /* Next Project: Fächer größer (Karte ≈ 47vw), nach links gerückt; Schrift darüber rechts */
    .pd-fan { --col: 24vw; --row: calc(24vw * 0.79); height: calc(25vw * 4); }
    .fan-card { margin-left: -30vw; margin-top: 20vw; }
    .fan-zone { left: 0; width: 100vw; top: -10vw; height: calc(100% + 10vw); }
    .pd-fan .np { left: 50vw; width: 50vw; top: 50vw; transform: translateY(-50%); font-size: 6vw; filter: blur(0.35vw); }
    /* Namen + „A FILM BY" erst einblenden, wenn das Video groß genug ist (--t = Scroll-Fortschritt) */
    .pd-names, .pd-cap { opacity: clamp(0, calc((var(--t, 1) - 0.6) * 2.5), 1); }
  }
</style>

<script>
  // Scroll-gekoppeltes Hero (Desktop + Mobile). Titel läuft nach oben raus, Metazeile kommt von
  // unten hoch, Video wandert nach unten und wächst. Alle Maße kommen aus dem jeweiligen Raster.
  const mq = window.matchMedia('(min-width: 768px)');
  const stage = document.getElementById('pdStage');
  const pin = stage ? stage.querySelector('.pd-pin') : null;
  const title = document.getElementById('pdTitle');
  const meta = document.getElementById('pdMeta');
  const video = document.getElementById('pdVideo');
  const header = document.getElementById('pdHeader');
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
  const lerp = (a, b, t) => a + (b - a) * t;
  // Galerie-Hero (Branding o. ä.): Leiste statt Einzel-Video
  const isGal = !!(video && video.dataset.gallery);
  const galBox = document.getElementById('pdGal');
  const galTrack = document.getElementById('pdGalTrack');
  const galItems = galTrack ? [...galTrack.children] : [];
  const galAr = galItems.map((el) => parseFloat(getComputedStyle(el).getPropertyValue('--ar')) || 1.5);
  const galC = video && video.dataset.galCenter != null ? +video.dataset.galCenter : -1;   // zentrierte Galerie
  const galGrow = galC >= 0 ? galC : 0;                         // dieses Element füllt anfangs die Startbox
  if (galItems[galGrow]) galItems[galGrow].classList.add('is-grow');
  const galRows = video && video.dataset.galRows ? +video.dataset.galRows : 3;
  const galFill = !!(video && video.dataset.galFill);   // Desktop: Bilder teilen sich die volle Breite (Porträts)
  const endCols = video && video.dataset.endCols ? +video.dataset.endCols : 0;
  const hasImp = !!document.getElementById('pdImp');

  // Raster-Einstellungen je Gerät. Positionen in Spalten/Zeilen (0-basiert gezählt).
  function grid() {
    if (mq.matches) {
      const ROW = 170;
      return {
        cols: 7, ROW,
        metaH: ROW,                       // Metazeile: 1 Zeile
        bigRows: isGal ? galRows : 4,     // Endzustand: Einzel-Video/-Bild 4 Zeilen × 7 Spalten (Galerie-Leiste: Standard 3)
        start: { col: 2, cols: 3, row: 2, rows: 2 },   // Spalte 3–5, Zeile 3–4
        minPin: 720,                      // Mindest-Scrollstrecke
        titleUp: 300, metaFrom: 230,      // Wege von Titel (nach oben) und Meta (von unten)
      };
    }
    const ROW = window.innerWidth / 4;    // mobil: 4 Spalten, Zeile = 25vw
    return {
      cols: 4, ROW,
      metaH: 2 * ROW,                     // Meta: 2 Zeilen (6 Infos auf 4 Spalten)
      bigRows: 3,                         // Endzustand: Video 3 Zeilen hoch
      start: isGal ? { col: 1, cols: 2, row: 2, rows: 2 }   // Galerie: Spalte 2–3, Zeile 3–4 (quadratisch, Querformat-Bilder)
                   : { col: 1, cols: 2, row: 2, rows: 4 },  // Spalte 2–3, Zeile 3–6 (hochkant, Format 1:2)
      minPin: 4 * ROW,
      titleUp: 1.8 * ROW, metaFrom: 1.4 * ROW,
    };
  }

  // Maße, die nur von der Fenstergröße abhängen → bei Resize neu berechnen.
  let G = grid(), PIN = 800, metaEnd = 0;
  // iPhone: Beim Scrollen fährt die Adressleiste ein/aus → innerHeight ändert sich ständig, alles
  // würde neu vermessen und die Seite springen. Mobil gilt deshalb eine feste Höhe, die sich nur
  // ändert, wenn sich die BREITE ändert (Drehen des Handys).
  let stableH = window.innerHeight, stableW = window.innerWidth;
  const viewH = () => {
    if (mq.matches || window.innerWidth !== stableW) { stableW = window.innerWidth; stableH = window.innerHeight; }
    return stableH;
  };
  let stageTop = 0;   // Oberkante der Bühne im Dokument (zwischengespeichert → beim Scrollen nichts messen)
  function measure() {
    G = grid();
    const H = viewH(), R = G.ROW;
    metaEnd = Math.round(H / 2 - G.metaH / 2);   // Metazeile landet mittig im Bildschirm
    // Galerie: Metazeile + Leiste (3 Zeilen) als Block mittig unter dem Header → die ganze Leiste
    // inkl. Vollbild-Knopf unten rechts ist im Bild (Header = 1 Rasterzeile hoch)
    if (isGal) metaEnd = Math.round(R + Math.max(0, (H - R - (G.metaH + G.bigRows * R)) / 2));
    // Scroll-Distanz so wählen, dass das (mitscrollende) Hintergrund-Raster am Ende genau
    // auf Metazeile + Video passt: (metaEnd + PIN) muss ein Vielfaches der Zeilenhöhe sein.
    PIN = G.minPin + ((R - ((metaEnd + G.minPin) % R)) % R);
    // Das große Video ist länger als der Bildschirm → Pin so hoch wie seine Unterkante
    // machen (sonst ragt es nach dem Pin in den nächsten Abschnitt). Bühne = Pin-Distanz + Pin.
    // Pin-Höhe = Unterkante des großen Videos (+ ganze Rasterzeilen, bis der Bildschirm gefüllt ist).
    // So endet die Bühne immer auf einer Rasterlinie → alles darunter (IMPRESSION-Leiste, Texte)
    // sitzt exakt in seinen Rasterzeilen. (Vorher bei kurzer Galerie: Bildschirmhöhe → Versatz.)
    const vidBottom = metaEnd + G.metaH + G.bigRows * R;
    // Desktop, Einzel-Video/-Bild: Bühne endet direkt unter dem großen Projekt → die IMPRESSION-Leiste
    // folgt mit genau 2 Zeilen Abstand (margin-top der Leiste). Sonst: bis der Bildschirm gefüllt ist.
    // Galerie OHNE Impression-Leiste: ebenso direkt danach enden → Texte folgen mit 1 Zeile Abstand.
    const pinH = ((!isGal || !hasImp) && mq.matches) ? vidBottom : vidBottom + Math.max(0, Math.ceil((H - vidBottom) / R)) * R;
    pin.style.height = pinH + 'px';
    stage.style.height = PIN + pinH + 'px';
    stageTop = stage.getBoundingClientRect().top + window.scrollY;
  }

  function apply(t) {
    const W = window.innerWidth, col = W / G.cols, R = G.ROW, s = G.start;
    // --title-y: vertikaler Ankerpunkt (Desktop: Mitte, Mobil: Unterkante → letzte Zeile wird angeschnitten)
    title.style.transform = `translate(-50%, calc(var(--title-y, -50%) + ${lerp(0, -G.titleUp, t).toFixed(1)}px))`;
    title.style.opacity = String(1 - clamp((t - 0.25) / 0.5, 0, 1));
    meta.style.transform = `translateY(${lerp(metaEnd + G.metaFrom, metaEnd, t).toFixed(1)}px)`;
    meta.style.opacity = String(clamp((t - 0.15) / 0.6, 0, 1));
    // Start: Feld im Raster (siehe grid())
    const l0 = s.col * col, w0 = s.cols * col, tp0 = s.row * R, h0 = s.rows * R;
    // Ende: volle Breite, direkt unter der mittigen Metazeile
    // Ende: Galerie volle Breite (bzw. endCols); Einzel-Video/-Bild am Desktop 5 Spalten breit, mittig (Spalte 2–6)
    const cols1 = !mq.matches ? G.cols : (endCols || G.cols);   // Desktop: volle Breite (7 Spalten)
    const w1 = (W / G.cols) * cols1, tp1 = metaEnd + G.metaH, h1 = G.bigRows * R;
    const l1 = (!isGal && !endCols && mq.matches) ? (W - w1) / 2 : 0;
    video.style.left = lerp(l0, l1, t).toFixed(1) + 'px';
    video.style.top = lerp(tp0, tp1, t).toFixed(1) + 'px';
    video.style.width = lerp(w0, w1, t).toFixed(1) + 'px';
    video.style.height = lerp(h0, h1, t).toFixed(1) + 'px';
    video.style.setProperty('--t', t.toFixed(3));   // Fortschritt fürs CSS (mobil: Beschriftung einblenden)
    // Galerie: 1. Element füllt anfangs genau die Startbox und wächst dann auf sein Seitenverhältnis
    if (isGal && galItems[galGrow]) {
      const h = lerp(h0, h1, t);
      const fill = galFill && mq.matches;
      // fill: am Ende ist jedes Bild genau 1/n der Boxbreite breit (alle zusammen = volle Breite, angeschnitten)
      const wNew = lerp(w0, fill ? w1 / galItems.length : h * galAr[galGrow], t).toFixed(1) + 'px';
      if (galItems[galGrow].style.width !== wNew) galItems[galGrow].style.width = wNew;
      galItems.forEach((el, k) => {
        if (k === galGrow) return;
        const v = fill ? (lerp(w0, w1, t) / galItems.length).toFixed(1) + 'px' : '';
        if (el.style.width !== v) el.style.width = v;
      });
      // zentrierte Galerie: Leiste so verschieben, dass das wachsende Element mittig in der Box steht
      if (galC >= 0 && galTrack) {
        const boxW = lerp(w0, w1, t), el = galItems[galGrow];
        galXC = boxW / 2 - (el.offsetLeft + parseFloat(wNew) / 2);
        applyCenter();
      }
    }
  }
  // Galerie (Desktop): Leiste wird mit dem Mausrad ÜBER der Leiste verschoben (galOff = px nach links).
  // Seiten-Scrollen bewegt nur die Seite – das Hintergrund-Raster bleibt dabei in Ruhe.
  // galTarget = Ziel aus dem Mausrad, galOff = angezeigte Position; galOff läuft per rAF weich
  // hinterher (wie bei der IMPRESSION-Leiste) → auch schnelle Trackpad-Gesten bleiben flüssig.
  let galOff = 0, galTarget = 0, galRaf = 0;
  let galXC = 0;   // zentrierte Galerie: Leisten-Position, bei der das Mittelbild mittig steht
  const galMax = () => (galTrack && galBox ? Math.max(0, galTrack.scrollWidth - galBox.clientWidth) : 0);
  // Erlaubter Verschiebe-Bereich: normale Leiste 0 … Überstand; zentrierte Leiste (Porträts) so,
  // dass sie nie über ihre Enden hinaus verschoben wird – passt alles in die Box, gar nicht.
  function galRange() {
    if (galC < 0) return [0, galMax()];
    if (!galTrack || !galBox || galT < 0.98) return [0, 0];
    const over = galTrack.scrollWidth - galBox.clientWidth;
    if (over <= 1) return [0, 0];
    return [galXC, galXC + over];
  }
  function applyCenter() {
    if (!galTrack) return;
    const [lo, hi] = galRange();
    galTarget = clamp(galTarget, lo, hi); galOff = clamp(galOff, lo, hi);
    galTrack.style.transform = `translate3d(${(galXC - galOff).toFixed(1)}px,0,0)`;
  }
  function applyGal() {
    if (!galTrack) return;
    if (galC >= 0) { applyCenter(); return; }   // zentrierte Galerie (auch mobil per Wischen)
    if (!mq.matches) { galOff = galTarget = 0; if (galTrack.style.transform) galTrack.style.transform = ''; return; }
    const m = galMax();
    galTarget = clamp(galTarget, 0, m); galOff = clamp(galOff, 0, m);
    galTrack.style.transform = `translate3d(${(-galOff).toFixed(1)}px,0,0)`;
  }
  function galGlide() {
    cancelAnimationFrame(galRaf);
    const step = () => {
      const d = galTarget - galOff;
      galOff = Math.abs(d) < 0.5 ? galTarget : galOff + d * 0.18;
      applyGal();
      if (galOff !== galTarget) galRaf = requestAnimationFrame(step);
    };
    galRaf = requestAnimationFrame(step);
  }
  // Sobald man die große Leiste waagerecht bewegt, rutscht sie (sanft) an den unteren Bildschirmrand –
  // so bleiben die Infos darüber gut lesbar. Nie höher als der Endzustand des Titelbilds.
  let galJumping = false;
  function centerGal() {
    if (galJumping || !galBox || !stage) return;
    const r = galBox.getBoundingClientRect();
    const diff = r.bottom - window.innerHeight;
    if (Math.abs(diff) < 24) return;
    const minY = stage.getBoundingClientRect().top + window.scrollY + PIN;   // Endzustand
    const target = Math.max(minY, window.scrollY + diff);
    if (Math.abs(target - window.scrollY) < 4) return;
    galJumping = true;
    window.scrollTo({ top: target, behavior: 'smooth' });
    setTimeout(() => { galJumping = false; }, 800);
  }
  let ticking = false;
  let galT = 0;
  let galResetting = false;   // Wachstums-Fortschritt der Galerie (erst ab ganz groß per Mausrad verschiebbar)
  let startTeaser = () => {};   // wird unten gesetzt, falls es einen Clip gibt
  function onScroll() {
    if (header) header.classList.toggle('is-scrolled', window.scrollY > 4);
    if (!stage) return;
    const y = window.scrollY - stageTop;   // ohne Messen (spart pro Bild eine komplette Layout-Berechnung)
    const t = clamp(y / PIN, 0, 1);
    apply(t);
    if (isGal) {
      galT = t;
      // Zurück Richtung Anfang (Leiste schrumpft wieder zum Titelbild): Leiste auf den Anfang
      // zurücksetzen → in der Startbox steht wieder das richtige Titelbild/-video.
      if (t < 0.97) {
        if (galTarget !== 0 || galOff !== 0) { galTarget = 0; galGlide(); }
        if (galBox && galBox.scrollLeft > 0 && !galResetting) {
          galResetting = true;
          galBox.scrollTo({ left: 0, behavior: 'smooth' });
          setTimeout(() => { galResetting = false; }, 500);
        }
      }
      applyGal();
      // EN/DE-Schalter ausblenden, solange er auf der großen Leiste (Vollbild-Knopf) liegen würde
      const tg = document.querySelector('.lang-toggle');
      const nowT = performance.now();
      if (tg && galBox && nowT - lastTgCheck > 200) {   // nur alle 0,2 s prüfen (Messen bremst das Scrollen)
        lastTgCheck = nowT;
        const a = galBox.getBoundingClientRect(), b2 = tg.getBoundingClientRect();
        const hit = t > 0.3 && a.left < b2.right && a.right > b2.left && a.top < b2.bottom && a.bottom > b2.top;
        document.documentElement.classList.toggle('gal-pinned', hit);
      }
    }
    if (t > 0.01) startTeaser();   // sobald man zu scrollen beginnt: Clip starten
  }
  let lastTgCheck = 0;
  function tick() { if (ticking) return; ticking = true; requestAnimationFrame(() => { ticking = false; onScroll(); }); }

  if (stage && pin && title && meta && video) {
    window.addEventListener('scroll', tick, { passive: true });
    if (isGal && galBox) {
      // Desktop: Ist die große Leiste ganz groß und im Bild, wird JEDES Mausrad-/Trackpad-Scrollen
      // (egal wo der Cursor ist) erst in die Leiste umgeleitet. Erst wenn sie einmal ganz durch ist
      // (Ende beim Runterscrollen bzw. Anfang beim Hochscrollen), scrollt die Seite weiter.
      window.addEventListener('wheel', (e) => {
        if (!mq.matches || galT < 0.98 || e.ctrlKey || e.defaultPrevented) return;   // erst wenn die Leiste ganz groß ist; Pinch-Zoom nicht anfassen
        const gr = galBox.getBoundingClientRect();
        if (gr.bottom < window.innerHeight * 0.5 || gr.top > window.innerHeight * 0.5) return;   // Leiste nicht (mehr) mittig im Bild
        const dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY;
        const dx = e.deltaMode === 1 ? e.deltaX * 16 : e.deltaX;
        const d = Math.abs(dx) > Math.abs(dy) ? dx : dy;
        const [lo, hi] = galRange();
        const next = clamp(galTarget + d, lo, hi);
        if (next === galTarget) return;   // Anfang/Ende erreicht → Seite scrollt normal weiter
        e.preventDefault();
        galTarget = next; galGlide();
        centerGal();
      }, { passive: false });
      // mobil: natives waagerechtes Wischen der Leiste
      // (Mobil springt die Seite beim Wischen der Leiste NICHT an einen bestimmten Punkt – nur Desktop.)
      // zentrierte Galerie (Porträts) auf Touch-Geräten: waagerecht wischen verschiebt die Leiste
      // (nur wenn sie breiter als der Bildschirm ist); senkrecht scrollt weiter die Seite.
      if (galC >= 0) {
        let tx = 0, ty = 0, t0 = 0, horiz: boolean | null = null;
        galBox.addEventListener('touchstart', (e) => {
          tx = e.touches[0].clientX; ty = e.touches[0].clientY; t0 = galTarget; horiz = null;
        }, { passive: true });
        galBox.addEventListener('touchmove', (e) => {
          const dx = e.touches[0].clientX - tx, dy = e.touches[0].clientY - ty;
          if (horiz === null && Math.abs(dx) + Math.abs(dy) > 8) horiz = Math.abs(dx) > Math.abs(dy);
          if (!horiz) return;
          const [lo, hi] = galRange();
          galTarget = clamp(t0 - dx, lo, hi); galOff = galTarget; applyCenter();
        }, { passive: true });
      }
    }
    window.addEventListener('resize', () => {
      // mobil: reine Höhenänderung (Adressleiste) ignorieren → kein Springen beim Scrollen
      if (!mq.matches && window.innerWidth === stableW) return;
      measure(); onScroll();
    }, { passive: true });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { stageTop = stage.getBoundingClientRect().top + window.scrollY; });
    measure(); onScroll();

    // ===== Magnetischer Anfang =====
    // Bleibt man mitten im Wachsen des Titelbilds stehen, zieht die Seite es sanft fertig:
    // beim Runterscrollen in den Endzustand (Infos + Bild in ihren Rasterkacheln),
    // beim Hochscrollen zurück an den Anfang. Jede eigene Scroll-Eingabe bricht das Ziehen ab.
    let lastY = window.scrollY, dir = 1, snapTimer = 0, snapRaf = 0, snapping = false;
    const stopSnap = () => { if (snapping) { snapping = false; cancelAnimationFrame(snapRaf); } };
    function snapTo(target) {
      const from = window.scrollY, dist = target - from, t0 = performance.now(), dur = 520;
      const ease = (x) => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
      snapping = true;
      const step = (now) => {
        if (!snapping) return;
        const k = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, from + dist * ease(k));
        if (k < 1) snapRaf = requestAnimationFrame(step); else snapping = false;
      };
      snapRaf = requestAnimationFrame(step);
    }
    // Auf Touch-Geräten nicht nachziehen: Das programmierte Scrollen würde den natürlichen
    // Schwung beim Wischen abwürgen → abgehacktes Scrollen.
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    function snap() {
      if (coarse) return;
      const top = stage.getBoundingClientRect().top, t = -top / PIN;
      if (t <= 0.004 || t >= 0.996) return;                 // schon an einem Ende
      const stageTop = top + window.scrollY;
      snapTo(Math.round(dir > 0 ? stageTop + PIN : stageTop));
    }
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (y !== lastY && !snapping) dir = y > lastY ? 1 : -1;
      lastY = y;
      if (snapping) return;
      clearTimeout(snapTimer);
      snapTimer = setTimeout(snap, 170);                       // erst wenn das Scrollen zur Ruhe kommt
    }, { passive: true });
    ['wheel', 'touchstart', 'keydown'].forEach((ev) => window.addEventListener(ev, stopSnap, { passive: true }));

    // ===== Knöpfe auf hellen Bildern schwarz =====
    // Misst regelmäßig die Helligkeit des Bildes/Videos direkt unter Vollbild- und Play-Knopf
    // (kleine 8×8-Stichprobe) und färbt den Knopf schwarz, wenn Weiß zu wenig Kontrast hätte.
    const probe = document.createElement('canvas'); probe.width = probe.height = 8;
    const pctx = probe.getContext('2d', { willReadFrequently: true });
    function lumUnder(btn) {
      const r = btn.getBoundingClientRect();
      if (!r.width || r.bottom < 0 || r.top > window.innerHeight) return null;
      const media = document.elementsFromPoint(r.left + r.width / 2, r.top + r.height / 2).find((el) =>
        (el.tagName === 'IMG' || el.tagName === 'VIDEO') && el.closest('#pdVideo') && parseFloat(getComputedStyle(el).opacity) > 0.5);
      if (!media) return null;
      const nw = media.naturalWidth || media.videoWidth, nh = media.naturalHeight || media.videoHeight;
      if (!nw || !nh || (media.tagName === 'VIDEO' && media.readyState < 2)) return null;
      const b = media.getBoundingClientRect(), sc = Math.max(b.width / nw, b.height / nh);   // object-fit: cover
      const ox = (b.width - nw * sc) / 2, oy = (b.height - nh * sc) / 2;
      const sx = (r.left - b.left - ox) / sc, sy = (r.top - b.top - oy) / sc;
      try {
        pctx.drawImage(media, sx, sy, r.width / sc, r.height / sc, 0, 0, 8, 8);
        const d = pctx.getImageData(0, 0, 8, 8).data;
        let L = 0;
        for (let k = 0; k < d.length; k += 4) L += 0.2126 * d[k] + 0.7152 * d[k + 1] + 0.0722 * d[k + 2];
        return L / (d.length / 4) / 255;
      } catch (err) { return null; }
    }
    const contrastBtns = ['pdFull', 'pdGalFull', 'pdPlay'].map((id) => document.getElementById(id)).filter(Boolean);
    function checkContrast() {
      if (document.hidden) return;
      contrastBtns.forEach((btn) => {
        const L = lumUnder(btn);
        if (L != null) btn.classList.toggle('is-dark', L > 0.62);
      });
    }
    // Nicht bei jedem Scroll-Bild messen (das Auslesen von Bildpunkten bremst das Scrollen, v. a. am
    // iPhone) – sondern regelmäßig und kurz nachdem das Scrollen zur Ruhe kommt.
    let cTimer = 0, lastScrollAt = 0;
    setInterval(() => { if (performance.now() - lastScrollAt > 300) checkContrast(); }, 500);
    window.addEventListener('scroll', () => { lastScrollAt = performance.now(); clearTimeout(cTimer); cTimer = setTimeout(checkContrast, 160); }, { passive: true });

    // Play-Button: Video abspielen (falls vorhanden)
    const play = document.getElementById('pdPlay');
    const vid = document.getElementById('pdMediaVideo');

    // Clip (Vorschau, z. B. die ersten 20–40 s): startet beim ersten Scrollen stumm in Schleife,
    // blendet über das Cover, sobald er wirklich läuft. Pausiert außerhalb des Bildschirms.
    // Bei „Bewegung reduzieren" (Systemeinstellung) kein automatischer Start.
    if (vid && vid.tagName === 'VIDEO') {
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let started = false, inView = true;
      vid.addEventListener('playing', () => vid.classList.add('is-playing'));
      let trying = false;
      startTeaser = () => {
        if (started || trying || calm) return;
        trying = true;
        vid.muted = true; vid.defaultMuted = true; vid.playsInline = true;
        const p = vid.play();
        // Klappt es, gilt der Clip als gestartet. Lehnt der Browser ab (Safari-Stromsparmodus,
        // Autoplay-Sperre …), bleibt das Cover stehen; der nächste Klick/Tipp versucht es erneut.
        const ok = () => { started = true; trying = false; };
        const fail = () => { trying = false; };
        if (p && p.then) p.then(ok, fail); else ok();
      };
      // Safari-Stromsparmodus: Video darf nur nach einer echten Geste starten (Klick, Tippen, Taste –
      // NICHT Scrollen/Mausbewegen). Darum hier diese Gesten abfangen und den Start nachholen.
      ['pointerup', 'touchend', 'click', 'keydown'].forEach((ev) =>
        window.addEventListener(ev, () => { if (!started) startTeaser(); }, { passive: true, capture: true }));
      new IntersectionObserver(([en]) => {
        inView = en.isIntersecting;
        if (!started) return;
        if (inView && vid.paused) vid.play().catch(() => {});
        if (!inView && !vid.paused) vid.pause();
      }).observe(video);
      // Lautsprecher: Ton an/aus. Browser erlauben Ton erst nach einem Klick – deshalb startet
      // der Clip stumm, und dieser Knopf schaltet den Ton dazu.
      const sound = document.getElementById('pdSound');
      if (sound) {
        const syncSound = () => {
          sound.setAttribute('aria-pressed', String(!vid.muted));
          sound.setAttribute('aria-label', vid.muted ? 'Turn sound on' : 'Turn sound off');
        };
        sound.addEventListener('click', () => {
          vid.muted = !vid.muted;
          if (!vid.muted && vid.paused) vid.play().catch(() => {});
        });
        vid.addEventListener('volumechange', syncSound);   // Symbol folgt dem echten Zustand
        syncSound();
      }
      onScroll();   // falls die Seite schon gescrollt geladen wurde
      // Wird in den ersten 2 Sekunden nicht gescrollt, startet der Clip auch so (in der Startansicht)
      setTimeout(startTeaser, 2000);
    }
    const startVideo = () => {
      vid.muted = false;
      const p = vid.play();
      if (p && p.catch) p.catch(() => { vid.muted = true; vid.play(); });
      if (play) play.classList.add('is-hidden');
    };
    if (play && vid && vid.tagName === 'VIDEO') {
      play.addEventListener('click', startVideo);
    } else if (play) {
      play.classList.remove('is-hidden'); // kein Video hinterlegt → Play bleibt dekorativ
    }

    // ===== Galerie: Play verschwindet, sobald das 1. Video läuft; weitere Videos laufen, wenn sichtbar;
    // Vollbild-Ansicht mit Pfeilen =====
    if (isGal) {
      if (play && vid) vid.addEventListener('playing', () => play.classList.add('is-hidden'));
      const calmG = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('video.pd-gal-auto').forEach((v) => {
        v.addEventListener('playing', () => v.classList.add('is-playing'));
        new IntersectionObserver(([en]) => {
          if (en.isIntersecting && !calmG) v.play().catch(() => {});
          else if (!en.isIntersecting) v.pause();
        }, { threshold: 0.25 }).observe(v);
      });

      const lb = document.getElementById('pdLb');
      const lbStage = document.getElementById('pdLbStage');
      const lbCount = document.getElementById('pdLbCount');
      const galFull = document.getElementById('pdGalFull');
      // Inhalte der Leiste: je Element Quelle + Typ (bei Videos das <video>, sonst das Bild)
      const slides = galItems.map((fig) => {
        const v = fig.querySelector('video');
        return v ? { type: 'video', src: v.getAttribute('src'), poster: v.getAttribute('poster') }
                 : { type: 'image', src: fig.querySelector('img').getAttribute('src'), alt: fig.querySelector('img').alt };
      });
      // zusätzliche Bilder nur fürs Vollbild (z. B. Hochformate bei Comeback)
      (video.dataset.lbExtra || '').split('|').filter(Boolean).forEach((src) => slides.push({ type: 'image', src, alt: '' }));
      let cur = 0;
      // Element, das gerade am meisten in der Leiste zu sehen ist → damit startet das Vollbild
      const visibleIndex = () => {
        const b = galBox.getBoundingClientRect();
        let best = 0, bestW = -1;
        galItems.forEach((el, k) => {
          const r = el.getBoundingClientRect();
          const w = Math.min(r.right, b.right) - Math.max(r.left, b.left);
          if (w > bestW) { bestW = w; best = k; }
        });
        return best;
      };
      const show = (k) => {
        cur = (k + slides.length) % slides.length;
        const sl = slides[cur];
        lbStage.innerHTML = '';
        let el;
        if (sl.type === 'video') {
          el = document.createElement('video');
          Object.assign(el, { src: sl.src, muted: true, loop: true, autoplay: true, playsInline: true });
          if (sl.poster) el.poster = sl.poster;
          el.play().catch(() => {});
        } else {
          el = document.createElement('img');
          el.src = sl.src; el.alt = sl.alt || '';
        }
        lbStage.appendChild(el);
        lbCount.textContent = `${cur + 1} / ${slides.length}`;
      };
      const onKey = (e) => {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(cur + 1);
        else if (e.key === 'ArrowLeft') show(cur - 1);
      };
      const open = () => {
        show(visibleIndex());
        lb.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        document.addEventListener('keydown', onKey);
        // echtes Vollbild, wo möglich (iPhone kann das für Elemente nicht → bleibt bildschirmfüllende Ebene)
        if (lb.requestFullscreen) lb.requestFullscreen().catch(() => {});
        document.getElementById('pdLbClose').focus();
      };
      const close = () => {
        if (lb.hidden) return;
        lb.hidden = true;
        lbStage.innerHTML = '';
        document.documentElement.style.overflow = '';
        document.removeEventListener('keydown', onKey);
        if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
        galFull.focus();
      };
      galFull.addEventListener('click', open);
      document.getElementById('pdLbClose').addEventListener('click', close);
      document.getElementById('pdLbPrev').addEventListener('click', () => show(cur - 1));
      document.getElementById('pdLbNext').addEventListener('click', () => show(cur + 1));
      // Esc im echten Vollbild beendet zuerst das Vollbild → dann auch die Ansicht schließen
      document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement) close(); });
      // Wischen im Vollbild (Handy): links/rechts
      let sx = null;
      lb.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
      lb.addEventListener('touchend', (e) => {
        if (sx == null) return;
        const dx = e.changedTouches[0].clientX - sx; sx = null;
        if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1));
      }, { passive: true });
    }

    // Vollbild-Knopf: Video starten und im Vollbild zeigen (mit nativen Steuerelementen).
    // iPhone-Safari kennt kein requestFullscreen für Videos → dort webkitEnterFullscreen.
    const full = document.getElementById('pdFull');
    if (full && vid && vid.tagName === 'VIDEO') {
      full.addEventListener('click', () => {
        startVideo();
        vid.controls = true;
        if (vid.requestFullscreen) vid.requestFullscreen().catch(() => {});
        else if (vid.webkitEnterFullscreen) vid.webkitEnterFullscreen();
      });
      // Vollbild verlassen → Steuerelemente wieder ausblenden (Look der Seite bleibt sauber)
      document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement) vid.controls = false; });
      vid.addEventListener('webkitendfullscreen', () => { vid.controls = false; });
    }
  }

  // Mausrad/Trackpad-Weg in Pixeln (vertikal oder horizontal, je nachdem was größer ist)
  const wheelPx = (e) =>
    (Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX) * (e.deltaMode === 1 ? 16 : 1);

  // ===== IMPRESSION-Karussell =====
  // Läuft NICHT von selbst. Die Leiste folgt der Maus – egal wo die Maus auf der Seite ist:
  // Maus nach rechts → die Leiste fährt nach rechts (von links kommen neue Bilder), nach links umgekehrt.
  // Touch: Leiste mit dem Finger waagerecht wischen. Das Mausrad scrollt ganz normal die Seite.
  const imp = document.getElementById('pdImp');
  const impTrack = document.getElementById('pdImpTrack');
  if (imp && impTrack) {
    let firstCopy = impTrack.children[impTrack.children.length / 2];  // 1. Bild der 2. Bildfolge
    // Nur Notlösung für sehr breite Bildschirme: ist eine Bildfolge schmaler als der Bildschirm, sähe
    // man zwei IMPRESSION-Felder gleichzeitig. Dann werden die Bilder innerhalb jeder Folge verdoppelt (Feld bleibt nur 1× pro Folge),
    // bis eine Folge sicher breiter als der Bildschirm ist. Gemessen erst, wenn die Bilder geladen sind.
    const widenImp = () => {
      const loopW = () => (impTrack.children[impTrack.children.length / 2] as HTMLElement).offsetLeft;
      let guard = 0;
      while (loopW() > 0 && loopW() < window.innerWidth && guard++ < 4) {
        const kids = [...impTrack.children] as HTMLElement[];
        const copy0 = kids.slice(0, kids.length / 2);
        const extra = copy0.filter((el) => el.tagName === 'IMG').map((el) => {
          const c = el.cloneNode() as HTMLElement; c.setAttribute('aria-hidden', 'true'); return c;
        });
        const first = [...copy0, ...extra];
        const second = first.map((el) => {
          const c = el.cloneNode(true) as HTMLElement; c.setAttribute('aria-hidden', 'true'); return c;
        });
        impTrack.replaceChildren(...first, ...second);
      }
      firstCopy = impTrack.children[impTrack.children.length / 2];
    };
    Promise.all([...impTrack.querySelectorAll('img')].map((im) =>
      im.complete ? Promise.resolve() : new Promise((r) => { im.addEventListener('load', r, { once: true }); im.addEventListener('error', r, { once: true }); })
    )).then(widenImp);
    let pos = 0;      // Position als Anteil (0–1) einer Bildfolge → passt auch, wenn die Bilder wachsen
    let push = 0, visible = true, last = performance.now();
    // Maus: jede waagerechte Bewegung auf der Seite schiebt die Leiste mit (weich nachgezogen) –
    // AUSSER die Maus liegt auf der Leiste selbst: dann steht sie still, damit man von Bild zu
    // Bild hovern kann (jeweils das Bild unter der Maus wird groß).
    let lastX = null, overImp = false;
    imp.addEventListener('mouseenter', () => { overImp = true; });
    imp.addEventListener('mouseleave', (e) => { overImp = false; lastX = e.clientX; });
    window.addEventListener('mousemove', (e) => {
      if (lastX != null && visible && !overImp) push += (e.clientX - lastX) * 1.6;
      lastX = e.clientX;
    }, { passive: true });
    document.addEventListener('mouseleave', () => { lastX = null; });
    // Mobil / Touch: die Leiste läuft von selbst langsam weiter (Auto-Drift) und lässt sich seitwärts
    // wischen – der Finger zieht sie 1:1 mit, beim Loslassen gleitet sie mit Schwung aus.
    // Senkrecht wischen scrollt weiter die Seite (touch-action: pan-y im CSS).
    const calmMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const autoDrift = () => !calmMotion && (!mq.matches || !window.matchMedia('(hover: hover)').matches);
    const DRIFT = 22;   // px pro Sekunde
    let tx = null, tT = 0, vx = 0, drag = 0;
    imp.addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; tT = performance.now(); vx = 0; push = 0; }, { passive: true });
    imp.addEventListener('touchmove', (e) => {
      if (tx == null) return;
      const x = e.touches[0].clientX, now = performance.now();
      drag += x - tx; vx = (x - tx) / Math.max(1, now - tT); tx = x; tT = now;
    }, { passive: true });
    const endTouch = () => { if (tx != null) push += vx * 260; tx = null; nextStep = performance.now() + 3200; };   // Schwung beim Loslassen
    imp.addEventListener('touchend', endTouch, { passive: true });
    imp.addEventListener('touchcancel', endTouch, { passive: true });
    // IMPRESSION-Feld = genau 1 Rasterspalte (Desktop 7, Mobile 4 Spalten)
    const setCol = () => imp.style.setProperty('--imp-col', imp.clientWidth / (mq.matches ? 7 : 4) + 'px');
    setCol();
    window.addEventListener('resize', setCol, { passive: true });
    // nur animieren, wenn die Leiste im Bild ist
    new IntersectionObserver(([en]) => { visible = en.isIntersecting; }).observe(imp);

    // Mobil: Bilder auf ganze Rasterspalten bringen (Breite = n Spalten, Bild füllt per object-fit) →
    // alle Kanten liegen auf den Rasterlinien. Die Leiste rückt dann spaltenweise weiter und rastet
    // nach dem Wischen auf der nächsten Spalte ein.
    const impImgs = () => [...impTrack.querySelectorAll('img')] as HTMLImageElement[];
    let loopWC = 0;   // Breite einer Bildfolge (zwischengespeichert → nicht in jedem Bild messen)
    const fitImp = () => {
      const col = imp.clientWidth / 4, h = imp.clientHeight || col;
      impImgs().forEach((im) => {
        if (mq.matches) { im.style.width = ''; im.style.objectFit = ''; return; }
        const ar = im.naturalWidth && im.naturalHeight ? im.naturalWidth / im.naturalHeight : 1.5;
        const n = Math.max(1, Math.round((h * ar) / col));
        im.style.width = `calc(${n * col}px - 1px)`; im.style.objectFit = 'cover';
      });
      loopWC = firstCopy ? (firstCopy as HTMLElement).offsetLeft : 0;
    };
    Promise.all(impImgs().map((im) =>
      im.complete ? Promise.resolve() : new Promise((r) => { im.addEventListener('load', r, { once: true }); im.addEventListener('error', r, { once: true }); })
    )).then(() => setTimeout(fitImp, 0));
    window.addEventListener('resize', () => { if (!mq.matches && window.innerWidth === stableImpW) return; stableImpW = window.innerWidth; fitImp(); }, { passive: true });
    let stableImpW = window.innerWidth;
    let nextStep = performance.now() + 2600;   // mobil: nächstes spaltenweises Weiterrücken

    function impFrame(now) {
      const dt = Math.min((now - last) / 1000, 0.05); last = now;
      if (visible) {
        const mobileSteps = !mq.matches && autoDrift();
        const step = push * Math.min(1, dt * (tx == null && autoDrift() ? (mobileSteps ? 5 : 3) : 7));   // Schub weich nachziehen
        push -= step;
        const loopW = loopWC || (firstCopy ? (firstCopy as HTMLElement).offsetLeft : 0);   // Breite einer Bildfolge
        if (!loopWC && loopW) loopWC = loopW;
        if (loopW > 0 && mobileSteps && tx == null) {
          const col = imp.clientWidth / 4;
          if (Math.abs(push) < 0.5) {
            if (now > nextStep) { push -= col; nextStep = now + 2600; }   // eine Spalte weiter (nach links)
            else {
              const px = pos * loopW, near = Math.round(px / col) * col;   // auf nächste Spalte einrasten
              if (Math.abs(px - near) > 0.3) push += px - near;
            }
          }
        }
        if (loopW > 0) {
          // Bewegung nach rechts schiebt die Leiste nach rechts (pos sinkt); Auto-Drift nach links,
          // pausiert solange ein Finger auf der Leiste liegt (mobil: statt Driften spaltenweise)
          const drift = tx == null && autoDrift() && !mobileSteps ? DRIFT * dt : 0;
          pos = (((pos + (drift - step - drag) / loopW) % 1) + 1) % 1;
          drag = 0;
          impTrack.style.transform = `translateX(${(-pos * loopW).toFixed(1)}px)`;
        }
      }
      requestAnimationFrame(impFrame);
    }
    requestAnimationFrame(impFrame);
  }

  let footerDamp = (d) => 1;   // wird beim Footer-Reveal gesetzt (Dämpfung in der Fußzone)
  // ===== NEXT PROJECT-Fächer =====
  // Maus: über den Karten öffnet sich der Fächer, beim Verlassen schließt er wieder.
  // Touch: öffnet sich beim Scrollen in die untere Bildschirmhälfte (oder per 1. Antippen),
  // danach führt das Antippen einer Karte zum Projekt; Antippen außerhalb schließt.
  const fan = document.getElementById('pdFan');
  if (fan) {
    const cardsF = [...fan.querySelectorAll('.fan-card')];
    const canHover = window.matchMedia('(hover: hover)').matches;
    if (canHover) {
      cardsF.forEach((c) => c.addEventListener('mouseenter', () => fan.classList.add('is-open')));
      fan.addEventListener('mouseleave', () => fan.classList.remove('is-open'));
      // Mausrad/Trackpad über dem Fächer scrollt immer die Seite weiter (Safari „hängt" sonst an den
      // Karten fest und die Seite bewegt sich nicht). Wir scrollen deshalb selbst – in der Fußzone
      // gedämpft wie überall sonst (footerDamp kommt vom Footer-Reveal weiter unten).
      fan.addEventListener('wheel', (e) => {
        if (e.ctrlKey || e.defaultPrevented) return;   // Zoomen per Pinch nicht anfassen
        const d = e.deltaY * (e.deltaMode === 1 ? 16 : 1);
        if (!d) return;
        e.preventDefault();
        window.scrollBy(0, d * footerDamp(d));
      }, { passive: false });
    } else {
      // Zustand VOR dem Antippen merken (der Fokus beim Antippen öffnet den Fächer schon)
      let wasOpen = false;
      fan.addEventListener('pointerdown', () => { wasOpen = fan.classList.contains('is-open'); }, true);
      cardsF.forEach((c) => c.addEventListener('click', (e) => {
        if (!wasOpen) { e.preventDefault(); fan.classList.add('is-open'); wasOpen = true; }
      }));
      document.addEventListener('click', (e) => {
        if (!fan.contains(e.target as Node)) fan.classList.remove('is-open');
      });
      // Mobil: Der Fächer öffnet sich von selbst, sobald er beim Scrollen in der unteren Bildschirmhälfte
      // ankommt (Oberkante über 88 % der Bildschirmhöhe – am Seitenende steht er mobil ganz unten).
      // Rutscht er beim Hochscrollen wieder unten aus dem Bild, schließt er sich. Ist er offen, führt
      // EIN Antippen einer Karte direkt zum Projekt.
      let fanTick = false;
      const checkFan = () => {
        fanTick = false;
        const r = fan.getBoundingClientRect(), H = window.innerHeight;
        if (r.top < H * 0.88 && r.bottom > 0) fan.classList.add('is-open');
        else if (r.top > H * 0.98) fan.classList.remove('is-open');
      };
      window.addEventListener('scroll', () => { if (!fanTick) { fanTick = true; requestAnimationFrame(checkFan); } }, { passive: true });
      checkFan();
    }
    // Tastatur: Fokus auf einer Karte öffnet den Fächer
    fan.addEventListener('focusin', () => fan.classList.add('is-open'));
    fan.addEventListener('focusout', (e) => { if (!fan.contains(e.relatedTarget as Node)) fan.classList.remove('is-open'); });
  }

  // ===== Texte mobil auf ganze Rasterzeilen einrasten =====
  // Jeder Textblock wird auf ein Vielfaches der Zeilenhöhe (25vw) aufgerundet, der Text sitzt
  // mittig darin → Texte liegen immer innerhalb der Rasterlinien. Desktop: festes CSS-Raster.
  const texts = [...document.querySelectorAll('#pdText .t')];
  function snapTexts() {
    const R = window.innerWidth / 4;
    texts.forEach((t) => {
      t.style.height = '';
      if (mq.matches) return;
      const h = t.firstElementChild ? t.firstElementChild.offsetHeight : 0;
      t.style.height = Math.max(1, Math.ceil((h + 16) / R)) * R + 'px';   // +16px Luft zur Linie
    });
  }
  if (texts.length) {
    snapTexts();
    window.addEventListener('resize', snapTexts, { passive: true });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(snapTexts);   // nach Font-Laden neu messen
  }

  // ===== Footer-Reveal (wie Work/About) =====
  // Die letzte Bildschirmhöhe der Seite ist eine leere Scrollzone. Scrollt man hinein, fährt der
  // Footer von unten hoch (Fortschritt 0→1), der Inhalt bleibt dabei stehen:
  // Desktop per position:sticky (Unterkante rastet unten ein), Mobile per Gegen-Verschiebung.
  const main = document.getElementById('pdMain');
  const footer = document.getElementById('pdFooter');
  const footerSpace = document.getElementById('pdFooterSpace');
  const FOOTER_DAMP = 0.35;   // Mausrad in der Fußzone gedämpft (gleiches Gefühl wie Work)
  if (main && footer && footerSpace) {
    const footerStart = () => footerSpace.offsetTop - window.innerHeight;   // Beginn der Fußzone
    let mainH = main.offsetHeight;   // Höhe zwischenspeichern (ResizeObserver) statt bei jedem Scroll-Bild zu messen
    if ('ResizeObserver' in window) new ResizeObserver(() => { mainH = main.offsetHeight; setStickyTop(); }).observe(main);
    function setStickyTop() {
      const v = Math.min(0, window.innerHeight - mainH) + 'px';   // Desktop UND mobil (wie About)
      if (main.style.top !== v) main.style.top = v;   // nur bei Änderung schreiben
    }
    function applyFooter() {
      const start = footerStart();
      const p = clamp((window.scrollY - start) / (footerSpace.offsetHeight || window.innerHeight), 0, 1);
      footer.style.transform = `translateY(${((1 - p) * 100).toFixed(2)}%)`;
      footer.classList.toggle('is-active', p > 0.5);
      // Inhalt hält der Browser per position:sticky fest (auch mobil) – kein Nachschieben per JS,
      // das am iPhone hinter dem Finger herhing.
      if (main.style.transform) main.style.transform = '';
    }
    let fTicking = false;
    const fTick = () => {
      if (fTicking) return; fTicking = true;
      requestAnimationFrame(() => { fTicking = false; setStickyTop(); applyFooter(); });
    };
    window.addEventListener('scroll', fTick, { passive: true });
    window.addEventListener('resize', fTick, { passive: true });
    // Desktop: ab Beginn der Fußzone abwärts gedämpft scrollen. Nicht eingreifen, wenn eine der
    // Leisten das Scrollen schon übernommen hat (preventDefault → defaultPrevented).
    footerDamp = (d) => (mq.matches && d > 0 && window.scrollY >= footerStart() - 1 ? FOOTER_DAMP : 1);
    window.addEventListener('wheel', (e) => {
      if (!mq.matches || e.defaultPrevented) return;
      const d = e.deltaY * (e.deltaMode === 1 ? 16 : 1);
      if (d > 0 && window.scrollY >= footerStart() - 1) { window.scrollBy(0, d * FOOTER_DAMP); e.preventDefault(); }
    }, { passive: false });
    setStickyTop(); applyFooter();
  }
</script>
