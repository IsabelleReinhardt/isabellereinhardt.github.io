  .wp-ghost-gap { height: var(--rowH); }

  /* Projekte: zentrierte Gruppe, nebeneinander, deutlich versetzt (→ Scrollen im Spalt) */
  .wp-proj-layer {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start;
    gap: 2.25rem 3rem; max-width: 78%; margin: 0 auto;
    padding: calc(var(--ppad) + 0.5rem) 0 calc(var(--ppad) + 2.5rem);
  }
  .wp-proj { display: block; max-width: calc(50% - 1.5rem); }   /* höchstens 2 nebeneinander → bleiben versetzt in einer Reihe */
  .wp-proj:nth-child(even) { margin-top: 8rem; }
  .wp-proj:nth-child(3n) { margin-top: 4rem; }
  .wp-proj-inner { display: block; text-decoration: none; color: inherit; width: calc(var(--fitH) * var(--ar)); max-width: 100%; }
  .wp-proj-media { height: auto; aspect-ratio: var(--ar); max-height: var(--fitH); overflow: hidden; box-shadow: -20px -20px 50px 0 #000, 20px 20px 50px 0 #000; }
  .wp-proj-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Titel + Kurzbeschreibung rechtsbündig unter dem Bild (ohne Nummer) */
  .wp-proj-meta { display: flex; justify-content: flex-end; text-align: right; margin-top: 0.8rem; }
  .wp-proj-title { font-family: var(--font-display); color: var(--color-off); font-size: 1rem; line-height: 1.35; }
  .wp-proj-title .ln { display: block; font-weight: 500; text-transform: uppercase; }
  .wp-proj-title .sub { display: block; font-weight: 300; margin-top: 0.15rem; }

  /* ===== Mobil (bis 767px): Tap-Akkordeon (Figma 18-901) ===== */
  @media (max-width: 767px) {
    .workpage { --rowH: 25vw; --m: 0; background-size: calc(100% / 4) 100%; }
    .wp-cursor { display: none; }
    /* Unten etwas Luft, damit der Footer erst später hochkommt (man die letzte Kategorie
       in Ruhe sieht, bevor die Footer-Zone beginnt). */
    .wp-main { padding-top: 25vw; padding-bottom: 45vh; }   /* bleibt sticky (wie Desktop/About) → Footer schiebt sich flüssig drüber */

    /* ---- Footer: Reveal wie Desktop; mobil KEIN Flex ----
       Logo + Wörter als ein unten verankerter Fluss-Block. Keine vh-Werte →
       der Abstand Logo → E-Mail ist bei JEDER Bildschirmhöhe gleich (fest 20px).
       DOM-Reihenfolge im Fluss: Mail · LinkedIn · Imprint · Privacy. */
    .wp-footer-inner {
      display: block; position: absolute; left: 0; right: 0; bottom: 9vw;
      text-align: center;
    }
    .wp-footer-logo { position: static; inset: auto; padding: 0; display: block; margin: 0; }
    .wp-footer-logo img { display: block; width: 28.8vw; max-width: 208px; margin: 0 auto 20px; }  /* 20% kleiner; 20px-Abstand zur E-Mail */
    .wp-footer-bar {
      position: static; inset: auto; height: auto; padding: 0; display: block;
      grid-template-columns: none;   /* Desktop-Grid restlos auflösen → sauberer Block-Fluss */
      text-align: center; font-size: 0.875rem; letter-spacing: 0.12em;   /* = Mobile-Navigation (WORK/ABOUT/CONTACT) */
    }
    /* Grid-Reste der Kinder zurücksetzen, sonst würden sie als Grid-Items platziert */
    .wp-footer-mail, .wp-footer-li, .wp-footer-legal { grid-column: auto; justify-self: auto; }
    .wp-footer-mail { display: block; }                       /* einzige kleingeschriebene Zeile */
    .wp-footer-li   { display: block; margin-top: 4.2vw; }
    .wp-footer-legal { display: block; margin-top: 4.2vw; }   /* Imprint + Privacy untereinander */
    .wp-footer-legal a { display: block; }
    .wp-footer-legal a + a { margin-top: 4.2vw; }
    /* keine eigene Linie oben: die Unterkante des Headers ist schon die 1px-Rasterlinie (wie About) */
    .wp-intro { height: 25vw; justify-content: center; align-items: flex-end; padding-left: 0; padding-bottom: 10px; border-top: 0; }
    .wp-intro span { font-size: 2.6vw; letter-spacing: 0.12em; }

    /* Kategorie = Akkordeon im Fluss (schiebt beim Öffnen die anderen nach unten) */
    .wp-cat { position: static; height: auto; }
    .wp-cat.is-open { height: auto; }   /* wichtig: Desktop-Festhöhe überschreiben, sonst Überlappung */
    .wp-cat-head { position: static; height: 25vw; justify-content: center; padding-left: 0; overflow: hidden; }   /* großer, offener Titel wird am Rand angeschnitten statt die Seite zu verbreitern */
    .wp-cat.is-open .wp-cat-head { height: 25vw; }
    .wp-cat-label {
      font-size: 15vw; text-align: center; filter: blur(1.2vw);
      transform-origin: center center; will-change: transform; cursor: pointer;
      transition: filter .3s ease, opacity .3s ease, transform .3s ease;
      /* Eintritt mobil: Überschriften blenden nacheinander ein (nur opacity, damit es nicht
         mit einem transform kollidiert; backwards = hält danach nicht die opacity). */
      animation: wp-fadein 0.6s ease backwards;
      animation-delay: calc(var(--i, 0) * 0.1s + 0.15s);
    }
    .wp-cat.is-open .wp-cat-label { filter: none; font-size: 17vw; }                  /* aktiv: scharf, nur etwas größer (passt in die Breite + mittig in der Zeile) */
    .workpage.has-open .wp-cat:not(.is-open) .wp-cat-label { filter: blur(1.2vw); opacity: 0.5; }

    /* Galerie: klappt im Fluss auf (Höhe per JS animiert) */
    /* Alle Galerien liegen offen im Fluss (keine Höhen-Animation → flüssiges Scrollen).
       Die mittige Kategorie ist „offen": Projekte voll sichtbar; die anderen gedimmt und leicht kleiner. */
    .wp-cat-scroll { position: static; inset: auto; display: block; height: auto; overflow: visible; z-index: auto; pointer-events: auto; }
    .wp-cat-scroll .wp-proj-layer { opacity: 0.18; transform: scale(0.94); transition: opacity .35s ease, transform .45s cubic-bezier(0.22, 1, 0.36, 1); }
    .wp-cat.is-open .wp-cat-scroll .wp-proj-layer { opacity: 1; transform: none; }
    .wp-spacer, .wp-ghost, .wp-ghost-gap, .wp-end-spacer { display: none; }   /* mobil: Akkordeon ohne Fortsetzungen und ohne den Desktop-Auslauf am Ende (sonst lange leere Fläche unter den Projekten) */

    /* Projekte: vertikal gestapelt, zentriert (Figma 18-901) */
    /* etwas kompakter: kleinere Bilder, weniger Abstand → geöffnete Kategorie kürzer */
    .wp-proj-layer { flex-direction: column; flex-wrap: nowrap; align-items: center; max-width: 100%; gap: 1.25rem; margin: 0; padding: 1.25rem 0.9rem 1.75rem; }
    .wp-proj, .wp-proj:nth-child(even), .wp-proj:nth-child(3n) { margin-top: 0; }
    .wp-proj { max-width: none; }
    /* Querformat 52vw breit; Hochformat höchstens ~66vw hoch (sonst würde es sehr lang) */
    .wp-proj-inner { width: min(52vw, 66vw * var(--ar)); max-width: 52vw; }
    .wp-proj-media { height: auto; aspect-ratio: var(--ar); }
  }
