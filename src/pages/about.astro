    .edu-detail .ab-detail-photo { left: auto; right: -6vw; height: auto; -webkit-mask-image: none; mask-image: none; }   /* rechte Spalte (Linie 3→Rand) */
    .exp-detail .ab-detail-photo { right: auto; left: -6vw; height: auto; -webkit-mask-image: none; mask-image: none; }   /* linke Spalte (Rand→Linie 1) */
    .ab-detail-photo img { object-position: 50% 30%; }
    .edu-detail .ab-detail-photo img { object-position: 32% 30%; }   /* Education: Ausschnitt nach rechts → Gesicht ganz im Bild */
    /* Beim Öffnen fährt das Foto von außen herein (edu von rechts, exp gespiegelt von links);
       der Text erscheint erst danach, wenn das Bild „reingefahren" ist. overflow-x:hidden der
       .aboutpage beschneidet den Off-Screen-Teil. */
    .ab-expandable.is-open .edu-detail .ab-detail-photo { animation: ab-photo-slide-r 0.55s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .ab-expandable.is-open .exp-detail .ab-detail-photo { animation: ab-photo-slide-l 0.55s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .ab-expandable.is-open .ab-tl-item { animation-delay: calc(var(--i, 0) * 0.1s + 0.32s); }   /* Text kurz nach dem Foto */
    /* Eingeklappt: Tap-Gruppe mittig zwischen eigener und nächster Überschrift (gleicher Abstand oben/unten). */
    .ab-expandable:not(.is-open) .ab-head { margin-bottom: 9vw; }
    .ab-expandable:not(.is-open) { margin-bottom: 9vw; }
    /* Timeline: Marker + Linie an der Seite, Datum/Text daneben; Text aus der Foto-Zone halten */
    .edu-detail .ab-tl, .exp-detail .ab-tl { margin-left: 0; margin-right: 0; gap: 11vw; }
    .edu-detail .ab-tl { gap: 7vw; }   /* Education hat mehr Einträge → Marker etwas enger */
    .tl-left .tl-desc { margin-left: 13vw; } .tl-right .tl-desc { margin-right: 13vw; }
    .tl-desc { font-size: var(--text-mobile); max-width: 46vw; } .tl-date { font-size: 2.9vw; }   /* Fließtext gut lesbar (global.css) */
    .tl-right .tl-desc { margin-left: auto; }   /* Experience: Textblock rechtsbündig halten */

    /* ---- Footer mobil: Logo + Wörter als unten verankerter Block (wie Work) ---- */
