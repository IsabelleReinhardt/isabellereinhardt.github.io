    text-transform: uppercase; letter-spacing: 0.2em; color: var(--color-off);
  }
  .ab-footer-bar a { color: var(--color-off); text-decoration: none; transition: color .2s; }
  .ab-footer-bar a:hover { color: var(--color-neon); }
  .ab-footer-li { grid-column: 1; grid-row: 1; justify-self: center; }
  .ab-footer-mail { grid-column: 4; grid-row: 1; justify-self: center; text-transform: none; letter-spacing: 0.1em; font-weight: 300; }
  .ab-footer-legal { display: contents; }
  .ab-footer-legal a:nth-of-type(1) { grid-column: 6; grid-row: 1; justify-self: center; }  /* Imprint – wie Landingpage */
  .ab-footer-legal a:nth-of-type(2) { grid-column: 7; grid-row: 1; justify-self: center; }  /* Privacy – wie Landingpage */

  /* ===== Mobile: vorläufiger, lesbarer Einspalter (eigenes Design folgt) ===== */
  @media (max-width: 767px) {
    .ab-grid { display: none; }   /* Desktop-Raster aus; Mobile nutzt ein CSS-Hintergrundraster */
    .ab-header { display: none; }
    .ab-reveal { animation: none; clip-path: none; }   /* Aufschiebe-Animation nur Desktop */
    .ab-photo-img, .ab-intro { animation: none; }       /* Foto-Swoosh / Intro-Fade nur Desktop */
    .aboutpage { padding-top: 25vw; overflow-x: clip; }   /* clip statt hidden: sonst funktioniert sticky nicht */
    /* Sichtbares Hintergrundraster (4 Spalten + Reihen = Header-Höhe) auf .ab-main statt
       .aboutpage: So bleibt das Raster beim Footer-Reveal mit dem „festgehaltenen" Inhalt
       stehen (.ab-main wird translatiert), statt eigenständig nach oben zu scrollen. Die
       Rasterlinien liegen dadurch unverändert bei doc-y = n*25vw − 1 (ab-main beginnt bei 25vw). */
    .ab-main {
      padding-top: 0;
      background-image:
        linear-gradient(to right,  var(--color-line) 1px, transparent 1px),
        linear-gradient(to bottom, var(--color-line) 1px, transparent 1px);
      background-size: calc(100% / 4) 100%, 100% 25vw;
