    /* Unten viel Luft, damit man CURRENTLY in Ruhe lesen kann, bevor die Footer-Zone
       (letzte Viewport-Höhe) erreicht wird und der Footer hochzufahren beginnt. */
    .ab-content { margin-left: 0; width: auto; padding: 6vw 6vw 25vw; }   /* unten nur 1 Rasterzeile Luft vor der Fußzone */
    .ab-sec { margin-bottom: 12vw; }
    .ab-head { font-size: 9.5vw; filter: blur(1.2vw); margin-bottom: 5vw; }
    .ab-body { font-size: var(--text-mobile); }   /* gut lesbar auf dem Handy (global.css) */
    /* Tap-Zeile: absolute Positionierung zurücksetzen; Gruppe ganz links (Edu) bzw. ganz rechts (Exp) */
    .ab-tap { position: static; height: auto; display: flex; align-items: center; gap: 22px; }
    .ab-tap.edu { justify-content: flex-start; }
    .ab-tap.exp { justify-content: flex-end; }
    .ab-tap .sq { position: static; }
    .ab-tap .lbl { position: static; transform: none; font-size: 0.875rem; }  /* = Navigationsleisten-Größe */
    .ab-tap.edu .sq, .ab-tap.exp .sq { left: auto; }
    .ab-tap.edu .lbl, .ab-tap.exp .lbl { left: auto; right: auto; }
    /* Detail nach Figma 95-232: Timeline seitlich (Marker + Linie), Foto als Vollhöhen-Streifen
       am äußeren Rand. Education: Foto rechts; Experience gespiegelt (Foto links). */
    .ab-expandable.is-open .ab-detail { display: block; position: relative; margin-top: 6vw; }
    .ab-detail-photo { position: absolute; top: 0; bottom: 0; margin: 0; width: 25vw; height: auto; }   /* genau 1 Rasterspalte */
    /* mask:none hier (0,2,0) überschreibt die Desktop-Verläufe (gleiche Spezifität, später) → kein Übergang zur Transparenz */
    /* height:auto hier (0,2,0) überschreibt die Desktop-Festhöhe (6/4 Reihen) → top+bottom bestimmen
