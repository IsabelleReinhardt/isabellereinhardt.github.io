    .ab-expandable .ab-head { transform-origin: 50% 63.5px; transition: filter .3s ease, transform .45s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .ab-expandable .ab-tap  { transform-origin: 50% -29.5px; transition: transform .45s cubic-bezier(0.34, 1.56, 0.64, 1); }
