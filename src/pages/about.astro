  .ab-expandable:not(.is-open) .ab-head { margin-bottom: 45px; }
  .ab-expandable:not(.is-open) { margin-bottom: 45px; }
  .ab-detail { display: none; }
  /* Quadrat beim Ausklappen ausgegraut (wie der aktive Nav-Link im Header) */
  .ab-expandable.is-open .ab-tap .sq { opacity: 0.5; }
  .ab-expandable.is-open .ab-detail { display: block; position: relative; margin-top: 36px; }
  /* Aufklappen: die einzelnen Timeline-Kästchen ploppen nacheinander auf (gestaffelt über --i,
     mit leichtem Feder-Overshoot). Nur opacity/transform — verändert das Layout-Rect nicht,
     das snapPhotos() direkt nach dem Öffnen fürs Raster-Snapping ausmisst. */
  .ab-expandable.is-open .ab-tl-item {
    animation: ab-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--i, 0) * 0.14s + 0.1s);   /* langsamer + größerer Versatz, damit jedes Kästchen wahrnehmbar aufploppt */
  }
  @keyframes ab-pop {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  /* Das Foto blendet sanft mit dem ersten Kästchen ein. */
  .ab-expandable.is-open .ab-detail-photo { animation: ab-detailfade 0.6s ease 0.05s both; }
  @keyframes ab-detailfade { from { opacity: 0; } to { opacity: 1; } }
  /* Mobile: Foto fährt von außen in den Bildschirm (edu von rechts, exp von links). */
  @keyframes ab-photo-slide-r { from { transform: translateX(32vw); }  to { transform: translateX(0); } }
  @keyframes ab-photo-slide-l { from { transform: translateX(-32vw); } to { transform: translateX(0); } }

  /* Foto: feste Rasterhöhe (Edu 5, Exp 3 Zeilen), blutet über die About-Spaltengrenze.
     Education: Oberkante unter der Überschrift, Verlauf an der UNTERkante.
     Experience: Unterkante liegt auf dem Grid auf, Verlauf an der OBERkante. */
  .ab-detail-photo { position: absolute; overflow: hidden; }
  .ab-detail-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .edu-detail .ab-detail-photo {
    top: 0;
    left: calc(-1 * (var(--ab-Wcol) + var(--ins-abs)));  /* Außenkante exakt auf der WORK-Linie (läuft mit dem Grid) */
    right: 84%;                 /* Innenkante: kurz vor der Marker-Achse (22%) */
    height: calc(var(--ab-row) * 6);   /* 6 Rasterkästchen hoch (per JS an die Timeline angepasst) */
    /* Heller Bildhintergrund → längerer, weich auslaufender Verlauf (2 Reihen, sanfte Kurve),
       damit der Übergang ins Schwarz so weich wirkt wie beim dunklen Experience-Foto */
    --fade: linear-gradient(to top, #000 0, #000 calc(100% - var(--ab-row) * 2),
      rgba(0,0,0,.8) calc(100% - var(--ab-row) * 1.55), rgba(0,0,0,.5) calc(100% - var(--ab-row) * 1.05),
      rgba(0,0,0,.22) calc(100% - var(--ab-row) * .6), rgba(0,0,0,.06) calc(100% - var(--ab-row) * .25), transparent 100%);
    -webkit-mask-image: var(--fade);
            mask-image: var(--fade);
  }
  .edu-detail .ab-detail-photo img { object-position: 50% 28%; }  /* ganze Figur sichtbar */
  .exp-detail .ab-detail-photo {
    bottom: 0;                  /* Unterkante liegt auf dem Grid auf (Fuß der Timeline) */
    left: 84%;                  /* Innenkante: kurz nach der Marker-Achse (78%) */
    right: calc(-1 * (var(--ab-Ccol) + var(--ins-abs)));  /* Außenkante exakt am Seitenrand (läuft mit dem Grid) */
    height: calc(var(--ab-row) * 4);   /* Standard 4 Rasterkästchen (per JS bis fast zum obersten Kästchen) */
    -webkit-mask-image: linear-gradient(to top, #000 calc(100% - var(--ab-row)), transparent 100%);  /* Verlauf = oberstes Kästchen (1 Reihe) */
            mask-image: linear-gradient(to top, #000 calc(100% - var(--ab-row)), transparent 100%);
  }
  .exp-detail .ab-detail-photo img { object-position: 50% 30%; }
  .exp-detail .ab-detail-photo img { object-position: 50% 22%; }

  /* Timeline — Marker-Achse direkt unter dem Quadrat (gleiche % wie das Quadrat) */
  .ab-tl { list-style: none; margin: 0; padding: 0; position: relative; display: flex; flex-direction: column; }
  /* Feste Item-Höhe statt gap → Marker haben IMMER den gleichen Abstand, unabhängig von der
     Textlänge (sonst variiert der Abstand mit der Beschreibungslänge, v. a. bei Experience). */
  .edu-detail .ab-tl-item { min-height: 186px; }
  .exp-detail .ab-tl-item { min-height: 280px; }   /* mehr Luft zwischen den Experience-Einträgen */
  /* Zusatzabstand (per JS), damit das unterste Kästchen auf einer Rasterlinie endet */
  .ab-tl-item:not(:last-child) { margin-bottom: var(--tl-extra, 0px); }
  .edu-detail .ab-tl  { margin-left:  calc(22% - 17px); }  /* 1. Marker-Achse = Quadrat-Achse */
  .exp-detail .ab-tl  { margin-right: calc(22% - 17px); }
  /* Verbindungslinie: dünn, weiß, nur vom 1. bis zum letzten Kästchen (Höhe per JS gesetzt) */
  .ab-tl::before { content: ''; position: absolute; top: var(--tl-top, 17px); height: var(--tl-h, 0); width: 1px; background: var(--color-off); }
  .tl-left::before  { left: 16.5px; }
  .tl-right::before { right: 16.5px; }
  .ab-tl-item { display: flex; flex-direction: column; }
  .tl-row { display: flex; align-items: center; gap: 22px; }        /* Datum mittig neben dem Kästchen */
  .tl-right .tl-row { justify-content: flex-end; }
  .tl-mark { width: 34px; height: 34px; border: 1px solid var(--color-off); background: var(--color-ink); flex: none; position: relative; z-index: 1; }  /* dünn, weiß */
  .tl-date { font-family: var(--font-display); font-weight: 500; font-size: clamp(10px, 0.93vw, 14px); letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-off); }  /* weiß, Größe = Tap-Label, schrumpft mit dem Frame */
  .tl-desc { margin: 10px 0 0; font-family: var(--font-display); font-weight: 300; font-size: 1.05rem; line-height: 1.55; color: var(--color-off); }   /* = Fließtext Projektseiten */
  .tl-left  .tl-desc { margin-left: 56px; }                         /* unter dem Datum ausgerichtet (Kästchen 34 + Abstand 22) */
  .tl-right .tl-desc { margin-right: 56px; text-align: right; }
  /* Experience: Kurzbeschreibung klebt am Datum (zieht sich in den Leerraum neben dem Kästchen
     hoch); die Erläuterung darunter bekommt den Abstand, der sonst zwischen Datum und Text ist. */
  .tl-desc.tl-lead { margin-top: -4px; }
  /* Links in der Timeline (z. B. @mediendesign.rwu): unterstrichen, Hover neongrün */
  .tl-desc a { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; transition: color .2s; }
  .tl-desc a:hover { color: var(--color-neon); }
  .tl-desc.tl-more { margin-top: 18px; }

  /* ---------- Footer (schiebt sich beim Scrollen am Seitenende hoch — wie Work) ---------- */
  .ab-main { position: sticky; z-index: 1; padding-top: var(--ab-row); }   /* top per JS (setStickyTop) */
  /* Kein filter:blur mehr auf .ab-main — das zeichnete den gesamten (sehr hohen) Inhaltslayer
     pro Scroll-Frame neu und ruckelte stark. Die Unschärfe macht jetzt der backdrop-filter des
     Footers (GPU-beschleunigt, nur viewportgroß, Inhalt bleibt eingefroren). */
  .ab-footer {
    position: fixed; inset: 0; z-index: 40;
    transform: translateY(100%);   /* wird per nativem Scroll gesetzt → kein transition */
    will-change: transform;
    pointer-events: none;
    background: linear-gradient(to top,
      rgba(0,0,0,0.94) 0%, rgba(0,0,0,0.9) 30%, rgba(0,0,0,0.72) 55%,
      rgba(0,0,0,0.4) 78%, rgba(0,0,0,0) 100%);
