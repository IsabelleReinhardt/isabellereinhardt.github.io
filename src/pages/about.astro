  .ab-footer.is-active { pointer-events: auto; }
  .ab-footer-inner { display: contents; }
  .ab-footer-space { height: 100vh; }   /* unsichtbare Scrollzone am Seitenende */
  @media (max-width: 767px) { .ab-footer-space { height: 130vh; } }   /* mobil: Footer steigt etwas langsamer auf */
  .ab-footer-logo { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding-top: var(--ab-row); }
  .ab-footer-logo img { width: 15vw; max-width: 210px; height: auto; }
  .ab-footer-bar {
    position: absolute; left: 0; right: 0; bottom: 0; height: var(--ab-row);
    display: grid; grid-template-columns: repeat(7, 1fr); align-items: center;
    padding: 0;
