    .ab-hero { height: 25vw; display: flex; align-items: center; padding: 0 6vw; font-size: 13vw; }
    .ab-photo { height: 75vw; margin-top: 0; }
    .ab-photo-img { position: relative; left: 0; right: auto; width: 100%; height: 75vw; -webkit-mask-image: none; mask-image: none; }
    /* Foto nach links schieben (14 % der Breite), damit rechts Platz für den Intro-Text bleibt */
    .ab-photo-img img { width: 114%; max-width: none; margin-left: -14%; }
    /* Intro-Text in Schwarz über die rechte Hälfte des Bildes */
