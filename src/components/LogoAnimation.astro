const W_OFF=950, N_OFF=640;                                 // Balken / Kerbe stehen anfangs außerhalb
const GOO=18;                                               // Stärke des Flüssig-Effekts

// ===== Flugbahn des Kreises: durchgehende Kurve ohne Stopps =====
// [Zeit s, x, y]  – an jedem Punkt behält der Kreis seine Geschwindigkeit (kein Abbremsen auf 0),
// nur ganz am Ende (Ruheposition) kommt er zum Stehen.
const PATH=[
  [0.95, 720, 1330],   // Kreis liegt unsichtbar im weißen Balken …
  [1.05, 721, 1180],
  [1.15, 723,  900],   // … drückt sich als weiße Form aus der Spitze ins Schwarze (Frame 2)
  [1.25, 722,  560],
  [1.35, 720,  250],   // … das Loch schließt sich vor der Oberkante, der Kreis zieht als schwarzer Tropfen heraus (Frame 3)
  [1.42, 742,   60],   // Schwung holen …
  [1.47, 880, -120],
  [1.51, 1300, -190],  // … SEHR schnell ums Rechteck
  [1.55, 1800,   20],
  [1.59, 1955,  400],
  [1.63, 1810,  745],
  [1.67, 1440,  800],
  [1.71, 1215,  788],  // trifft rechts, quetscht sich hinein (Frame 4)
  [1.765, 1075,  783],  // drückt tiefer in die „Götterspeise" …
  [1.86, 1205,  780],  // … und federt zurück
  [1.95, 1135,  781],
  [2.03, 1158,  781],
  [2.20, 1010,  792],  // gleitet zwischen die Dreiecke
  [2.40,  768,  808],
  [2.50,  708,  808],  // kleines Überschwingen
  [2.63,  727,  808],
  [2.74,  723,  808],  // Ruhe (Frame 5)
];
const TOTAL=6.12, T_HOLD0=0.45, T_JUMP=0.5, T_REST=2.74, T_REFILL=4.24, T_REFILL_END=5.14;
const clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v)), lerp=(a,b,t)=>a+(b-a)*t;
const inOut=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2, outC=t=>1-Math.pow(1-t,3), inC=t=>t*t*t;
const inBack=t=>{const c=1.9;return (c+1)*t*t*t-c*t*t;};
const outElastic=t=>t<=0?0:t>=1?1:Math.pow(2,-10*t)*Math.sin((t*10-0.75)*(2*Math.PI)/3)+1;
// gedämpfte Feder: Ausschlag A, Frequenz f (Hz), Dämpfung d, Start t0
const spring=(t,t0,A,f,d)=>t<t0?0:A*Math.exp(-d*(t-t0))*Math.sin(2*Math.PI*f*(t-t0));

// Hermite-Spline durch PATH (Tangenten aus den Nachbarpunkten → gleichmäßiger Fluss)
function tang(i){const n=PATH.length-1; if(i===0||i===n) return [0,0];
  const a=PATH[i-1],b=PATH[i+1]; return [(b[1]-a[1])/(b[0]-a[0]),(b[2]-a[2])/(b[0]-a[0])];}
const TANG=PATH.map((_,i)=>tang(i));
TANG[0]=[0,-1800];    // schießt aus dem Balken nach oben
function pathAt(t){
  if(t<=PATH[0][0]) return [PATH[0][1],PATH[0][2],0,0];
  const n=PATH.length-1; if(t>=PATH[n][0]) return [PATH[n][1],PATH[n][2],0,0];
  let i=0; while(t>PATH[i+1][0]) i++;
  const [t0,x0,y0]=PATH[i],[t1,x1,y1]=PATH[i+1],h=t1-t0,u=(t-t0)/h;
  const m0=TANG[i],m1=TANG[i+1];
  const h00=2*u*u*u-3*u*u+1,h10=u*u*u-2*u*u+u,h01=-2*u*u*u+3*u*u,h11=u*u*u-u*u;
  const d00=6*u*u-6*u,d10=3*u*u-4*u+1,d01=-6*u*u+6*u,d11=3*u*u-2*u;
  return [h00*x0+h10*h*m0[0]+h01*x1+h11*h*m1[0], h00*y0+h10*h*m0[1]+h01*y1+h11*h*m1[1],
          (d00*x0+d10*h*m0[0]+d01*x1+d11*h*m1[0])/h, (d00*y0+d10*h*m0[1]+d01*y1+d11*h*m1[1])/h];
}
const $=(id)=>document.getElementById('la-'+id);
const Wp=$('W'),Np=$('N'),c1=$('c1'),c2=$('c2'),blur=$('gooBlur'),all=$('all');
const jellies=[...svgEl.querySelectorAll('.jelly')];

function render(t){
  // --- Balken (unteres Dreieck): springt rein, zuckt beim Ausspucken nach oben ---
  let wy=W_OFF;
  if(t>=T_HOLD0){const p=clamp((t-T_HOLD0)/T_JUMP); wy=W_OFF*Math.pow(1-p,4);}
  wy+=spring(t,0.70,-60,2.6,6);                       // leichter Bounce beim Ankommen (schießt etwas zu hoch, federt zurück)
  wy+=spring(t,1.03,-45,3.4,6);                       // Spitze stößt die weiße Form aus
  if(t>=T_REFILL+0.2){const p=clamp((t-T_REFILL-0.2)/0.5); wy=W_OFF*inBack(p)+spring(t,T_REFILL+0.2,-25,4,7);}

  // --- Kreis: Flugbahn, Größe, Dehnung in Flugrichtung ---
  let [cx,cy,vx,vy]=pathAt(t), r=0;
  if(t>=0.95) r=R;
  if(t>=T_REFILL){const p=clamp((t-T_REFILL)/0.35); r=R*(1-inBack(p)); if(p>=1) r=0;}
  if(t<0.95) r=0;
  const speed=Math.hypot(vx,vy), st=t>=0.95&&t<T_REST?clamp(speed/11000,0,0.2):0;
  const ang=Math.atan2(vy,vx)*180/Math.PI;

  // --- Kerbe (2. Dreieck): wird vom Kreis von rechts hineingedrückt ---
  let nx=N_OFF;
  if(t>=1.56&&t<T_REFILL) nx=clamp(cx-NOTCH[0],0,N_OFF);
  if(t>=2.1&&t<T_REFILL+0.1) nx=0;   // bis die Kerbe sich beim Auffüllen zurückzieht
  if(t>=T_REFILL+0.1){const p=clamp((t-T_REFILL-0.1)/0.45); nx=N_OFF*inBack(p)+spring(t,T_REFILL+0.1,30,3,6);}
  nx=Math.max(0,nx);

  // --- Götterspeise: das Rechteck federt (Dehnen nach oben, Quetschen von rechts, Nachwackeln) ---
  let sy=1+spring(t,1.27,0.08,2.6,4.2)     // Kreis zieht oben raus → reißt das Rechteck mit hoch
           +spring(t,1.71,0.025,4.6,7)       // Quetschen: wird etwas höher
           +spring(t,T_REFILL_END-0.15,-0.05,2.8,4.5);   // flüssiges Einschwingen nach dem Füllen
  let sx=1+spring(t,1.71,-0.055,4.6,7)      // von rechts eingedrückt
           +spring(t,T_REFILL_END-0.15,0.035,2.8,4.5);
  const ax=LEFT, ay=BOTTOM;                  // Anker: links unten
  const M=`matrix(${sx.toFixed(4)} 0 0 ${sy.toFixed(4)} ${(ax*(1-sx)).toFixed(2)} ${(ay*(1-sy)).toFixed(2)})`;
  jellies.forEach(g=>g.setAttribute('transform',M));

  // --- Flüssig-Filter: während der Bewegung an, beim stehenden Logo aus ---
  let g=GOO;
  if(t>=T_REST-0.05&&t<T_REFILL) g=GOO*(1-clamp((t-(T_REST-0.05))/0.25));
  if(t>=T_REFILL-0.12&&t<T_REFILL) g=0;
  if(t>=T_REFILL&&t<T_REFILL_END) g=GOO*clamp((t-T_REFILL)/0.45);   // erst mit der Bewegung einblenden (sonst füllt sich die Kerbe vorab)
  if(g<0.4){all.removeAttribute('filter');} else {all.setAttribute('filter','url(#la-goo)'); blur.setAttribute('stdDeviation',g.toFixed(2));}

  // nach oben: Balken wird von unten verankert gestreckt (Spitze rutscht hoch, die runde Ecke unten rechts bleibt wie sie ist)
  if(wy<0){const k=1+(-wy)/(BOTTOM-TIP_Y); Wp.setAttribute('transform',`translate(0 ${BOTTOM}) scale(1 ${k.toFixed(4)}) translate(0 ${-BOTTOM})`);}
  else Wp.setAttribute('transform',`translate(0 ${wy.toFixed(1)})`);
  // Bodenstück unter dem rechten Bein geht nie nach oben mit → die runde Ecke unten rechts bleibt rund
  $('Wb').setAttribute('transform',`translate(0 ${Math.max(0,wy).toFixed(1)})`);
  Np.setAttribute('transform',`translate(${nx.toFixed(1)} 0)`);
  // Austritt oben: das Loch schließt sich kurz vor der Oberkante, außen zieht der Kreis schwarz heraus
  const topY=BOTTOM-(BOTTOM-TOP)*sy;
  let rHole=r;
  if(t<1.5) rHole=r*clamp((cy-(topY+0.15*R))/(1.1*R));
  // Faden zwischen Oberkante und Tropfen (der Flüssig-Filter macht daraus einen weichen Hals)
  const gap=topY-cy, neck=$('neck');
  if(t<1.5&&gap>-R&&gap<2.4*R){const k=clamp((gap+R)/(3.4*R)); neck.setAttribute('cx',cx.toFixed(1)); neck.setAttribute('cy',((topY+cy)/2).toFixed(1));
    neck.setAttribute('rx',(R*0.62*(1-k)).toFixed(1)); neck.setAttribute('ry',(Math.max(0,gap)/2+R*0.35).toFixed(1));}
  else neck.setAttribute('rx','0');
  // schwarzer Kreis: bis zum Wiedereintritt nur außerhalb des Rechtecks sichtbar, danach wie gehabt
  c2.setAttribute('mask', t<1.6 ? 'url(#la-notR)' : 'url(#la-notS)');
  const rx=Math.max(0,r*(1+st)), ry=Math.max(0,r/(1+st));
  for(const c of [c1,c2]){const f=c===c1?rHole/Math.max(r,1e-6):1; c.setAttribute('cx',cx.toFixed(1));c.setAttribute('cy',cy.toFixed(1));
    c.setAttribute('rx',(rx*f).toFixed(1));c.setAttribute('ry',(ry*f).toFixed(1));
    c.setAttribute('transform',`rotate(${ang.toFixed(1)} ${cx.toFixed(1)} ${cy.toFixed(1)})`);}
}
// Endlosschleife; bei „Bewegung reduzieren" (Systemeinstellung) steht einfach das fertige Logo.
if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){ render(T_REST); }
else {
  let t=0, last=performance.now();
  const frame=(now)=>{ const dt=Math.min((now-last)/1000,0.05); last=now; t=(t+dt)%TOTAL; render(t); requestAnimationFrame(frame); };
  render(0); requestAnimationFrame(frame);
}
}
</script>
