---
// Navigationspunkte – zentral hier pflegbar
const links = [
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="relative z-20 flex items-center justify-between px-6 py-6 md:px-10">
  <!-- Platzhalter-Monogramm (monolinie iR mit Neon-Punkt) bis das finale Logo steht -->
  <a href="/" aria-label="Startseite" class="inline-flex">
    <svg width="40" height="40" viewBox="0 0 100 100" role="img" aria-label="Isabelle Reinhardt">
      <g fill="none" stroke="var(--color-off)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
        <line x1="24" y1="40" x2="24" y2="84" />
        <line x1="52" y1="20" x2="52" y2="84" />
        <path d="M52 20 H63 A16 16 0 0 1 63 52 H52" />
        <line x1="61" y1="52" x2="78" y2="84" />
      </g>
      <circle cx="24" cy="22" r="8" fill="var(--color-neon)" />
    </svg>
  </a>

  <nav>
    <ul class="flex gap-6 font-mono text-xs uppercase tracking-[0.14em] md:gap-10 md:text-sm">
      {links.map((l) => (
        <li>
          <a href={l.href} class="text-off transition-colors hover:text-neon">{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
